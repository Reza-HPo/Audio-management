@model IEnumerable<MaktabAhvaz.Domain.Entities.SiteSetting>

@{
    ViewData["Title"] = "تنظیمات سایت";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">تنظیمات سایت</h1>
            <p class="text-muted mb-0">
                مدیریت تنظیمات عمومی و سیستمی سایت
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i>
            افزودن تنظیم
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">

            @if (Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>کلید</th>
                                <th>مقدار</th>
                                <th>گروه</th>
                                <th>توضیحات</th>
                                <th>عمومی</th>
                                <th style="width: 180px;">عملیات</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        <code>@item.Key</code>
                                    </td>

                                    <td>
                                        @if (string.IsNullOrWhiteSpace(item.Value))
                                        {
                                            <span class="text-muted">
                                                بدون مقدار
                                            </span>
                                        }
                                        else if (item.Value.Length > 80)
                                        {
                                            <span title="@item.Value">
                                                @item.Value.Substring(0, 80)...
                                            </span>
                                        }
                                        else
                                        {
                                            @item.Value
                                        }
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.Group))
                                        {
                                            <span class="badge bg-light text-dark border">
                                                @item.Group
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.Description))
                                        {
                                            @item.Description
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.IsPublic)
                                        {
                                            <span class="badge bg-success">
                                                عمومی
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                خصوصی
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <div class="d-flex gap-2">

                                            <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-pencil"></i>
                                                ویرایش
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                                حذف
                                            </a>

                                        </div>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <div class="mb-3">
                        <i class="bi bi-gear fs-1 text-muted"></i>
                    </div>

                    <h5>
                        هنوز تنظیمی ایجاد نشده است.
                    </h5>

                    <p class="text-muted">
                        اولین تنظیم سایت را ایجاد کنید.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-primary">
                        افزودن اولین تنظیم
                    </a>

                </div>
            }

        </div>
    </div>

</div>