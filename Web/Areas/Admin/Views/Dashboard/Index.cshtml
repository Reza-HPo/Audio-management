@model Web.Areas.Admin.Controllers.DashboardViewModel

@{
    ViewData["Title"] = "داشبورد";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="admin-dashboard">

    <!-- =========================================================
         Dashboard Header
         ========================================================= -->
    <div class="dashboard-header">

        <div>
            <h1 class="dashboard-title">
                خوش آمدید 👋
            </h1>

            <p class="dashboard-subtitle">
                به پنل مدیریت مکتب اهواز خوش آمدید.
                از اینجا می‌توانید محتوای سایت را مدیریت کنید.
            </p>
        </div>

        <div class="dashboard-date">
            <span class="dashboard-date-label">
                امروز
            </span>

            <strong>
                @DateTime.Now.ToString("yyyy/MM/dd")
            </strong>
        </div>

    </div>


    <!-- =========================================================
         Statistics
         ========================================================= -->
    <div class="dashboard-stats">

        <!-- Audio Files -->
        <div class="dashboard-stat-card">

            <div class="dashboard-stat-icon audio">
                🎧
            </div>

            <div class="dashboard-stat-content">

                <span class="dashboard-stat-label">
                    فایل‌های صوتی
                </span>

                <strong class="dashboard-stat-value">
                    @Model.AudioFilesCount
                </strong>

                <a asp-area="Admin"
                   asp-controller="AudioFiles"
                   asp-action="Index"
                   class="dashboard-stat-link">
                    مدیریت فایل‌های صوتی
                    <span aria-hidden="true">←</span>
                </a>

            </div>

        </div>


        <!-- Speakers -->
        <div class="dashboard-stat-card">

            <div class="dashboard-stat-icon speaker">
                🎙️
            </div>

            <div class="dashboard-stat-content">

                <span class="dashboard-stat-label">
                    سخنران‌ها
                </span>

                <strong class="dashboard-stat-value">
                    @Model.SpeakersCount
                </strong>

                <a asp-area="Admin"
                   asp-controller="Speakers"
                   asp-action="Index"
                   class="dashboard-stat-link">
                    مدیریت سخنران‌ها
                    <span aria-hidden="true">←</span>
                </a>

            </div>

        </div>


        <!-- Categories -->
        <div class="dashboard-stat-card">

            <div class="dashboard-stat-icon category">
                🏷️
            </div>

            <div class="dashboard-stat-content">

                <span class="dashboard-stat-label">
                    دسته‌بندی‌ها
                </span>

                <strong class="dashboard-stat-value">
                    @Model.CategoriesCount
                </strong>

                <a asp-area="Admin"
                   asp-controller="Categories"
                   asp-action="Index"
                   class="dashboard-stat-link">
                    مدیریت دسته‌بندی‌ها
                    <span aria-hidden="true">←</span>
                </a>

            </div>

        </div>


        <!-- Pages -->
        <div class="dashboard-stat-card">

            <div class="dashboard-stat-icon pages">
                📄
            </div>

            <div class="dashboard-stat-content">

                <span class="dashboard-stat-label">
                    صفحات سایت
                </span>

                <strong class="dashboard-stat-value">
                    @Model.PagesCount
                </strong>

                <a asp-area="Admin"
                   asp-controller="Pages"
                   asp-action="Index"
                   class="dashboard-stat-link">
                    مدیریت صفحات
                    <span aria-hidden="true">←</span>
                </a>

            </div>

        </div>

    </div>


    <!-- =========================================================
         Dashboard Grid
         ========================================================= -->
    <div class="dashboard-grid">


        <!-- =====================================================
             Quick Actions
             ===================================================== -->
        <div class="dashboard-panel">

            <div class="dashboard-panel-header">

                <div>
                    <h2>
                        دسترسی سریع
                    </h2>

                    <p>
                        مدیریت سریع محتوای سایت
                    </p>
                </div>

            </div>


            <div class="dashboard-actions">

                <!-- Add Audio -->
                <a asp-area="Admin"
                   asp-controller="AudioFiles"
                   asp-action="Create"
                   class="dashboard-action">

                    <span class="dashboard-action-icon">
                        🎧
                    </span>

                    <span class="dashboard-action-content">

                        <strong>
                            افزودن فایل صوتی
                        </strong>

                        <small>
                            ثبت سخنرانی جدید
                        </small>

                    </span>

                    <span class="dashboard-action-arrow"
                          aria-hidden="true">
                        ←
                    </span>

                </a>


                <!-- Add Speaker -->
                <a asp-area="Admin"
                   asp-controller="Speakers"
                   asp-action="Create"
                   class="dashboard-action">

                    <span class="dashboard-action-icon">
                        🎙️
                    </span>

                    <span class="dashboard-action-content">

                        <strong>
                            افزودن سخنران
                        </strong>

                        <small>
                            ثبت سخنران جدید
                        </small>

                    </span>

                    <span class="dashboard-action-arrow"
                          aria-hidden="true">
                        ←
                    </span>

                </a>


                <!-- Add Category -->
                <a asp-area="Admin"
                   asp-controller="Categories"
                   asp-action="Create"
                   class="dashboard-action">

                    <span class="dashboard-action-icon">
                        🏷️
                    </span>

                    <span class="dashboard-action-content">

                        <strong>
                            افزودن دسته‌بندی
                        </strong>

                        <small>
                            ایجاد دسته‌بندی جدید
                        </small>

                    </span>

                    <span class="dashboard-action-arrow"
                          aria-hidden="true">
                        ←
                    </span>

                </a>


                <!-- Pages -->
                <a asp-area="Admin"
                   asp-controller="Pages"
                   asp-action="Index"
                   class="dashboard-action">

                    <span class="dashboard-action-icon">
                        📄
                    </span>

                    <span class="dashboard-action-content">

                        <strong>
                            مدیریت صفحات
                        </strong>

                        <small>
                            مدیریت صفحات سایت
                        </small>

                    </span>

                    <span class="dashboard-action-arrow"
                          aria-hidden="true">
                        ←
                    </span>

                </a>

            </div>

        </div>


        <!-- =====================================================
             System Status
             ===================================================== -->
        <div class="dashboard-panel">

            <div class="dashboard-panel-header">

                <div>
                    <h2>
                        وضعیت سیستم
                    </h2>

                    <p>
                        وضعیت بخش‌های اصلی سایت
                    </p>
                </div>

            </div>


            <div class="dashboard-status-list">


                <!-- Database -->
                <div class="dashboard-status-item">

                    <div class="dashboard-status-icon">
                        ✓
                    </div>

                    <div>

                        <strong>
                            پایگاه داده
                        </strong>

                        <span>
                            اتصال برقرار است
                        </span>

                    </div>

                    <span class="dashboard-status-badge success">
                        فعال
                    </span>

                </div>


                <!-- CMS -->
                <div class="dashboard-status-item">

                    <div class="dashboard-status-icon">
                        ✓
                    </div>

                    <div>

                        <strong>
                            سیستم مدیریت محتوا
                        </strong>

                        <span>
                            سیستم آماده استفاده است
                        </span>

                    </div>

                    <span class="dashboard-status-badge success">
                        فعال
                    </span>

                </div>


                <!-- Upload -->
                <div class="dashboard-status-item">

                    <div class="dashboard-status-icon">
                        ✓
                    </div>

                    <div>

                        <strong>
                            سیستم آپلود
                        </strong>

                        <span>
                            آماده دریافت فایل
                        </span>

                    </div>

                    <span class="dashboard-status-badge success">
                        آماده
                    </span>

                </div>


            </div>

        </div>

    </div>


    <!-- =========================================================
         Welcome Card
         ========================================================= -->
    <div class="dashboard-welcome">

        <div class="dashboard-welcome-icon">
            م
        </div>

        <div>

            <h2>
                مدیریت مکتب اهواز
            </h2>

            <p>
                از منوی سمت راست می‌توانید فایل‌های صوتی،
                سخنران‌ها، دسته‌بندی‌ها و سایر محتوای سایت
                را مدیریت کنید.
            </p>

        </div>

    </div>

</div>