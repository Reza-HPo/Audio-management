@model MaktabAhvaz.Domain.Entities.AudioFile

@{
    ViewData["Title"] = "حذف فایل صوتی";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">

    
    <div class="mb-4">
        <h1 class="h3 mb-2">
            حذف فایل صوتی
        </h1>

        <p class="text-muted mb-0">
            حذف فایل صوتی از آرشیو
        </p>
    </div>


    <div class="card shadow-sm border-0">

        <div class="card-body p-4">

            <div class="alert alert-danger">

                <h5 class="mb-3">
                    آیا از حذف این فایل صوتی مطمئن هستید؟
                </h5>

                <p class="mb-2">
                    این عملیات قابل بازگشت نیست.
                </p>

            </div>


            <div class="border rounded p-3 mb-4">

                <div class="mb-2">

                    <strong>
                        عنوان:
                    </strong>

                    @Model.Title

                </div>


                @if (Model.Speaker != null)
                {
                    <div class="mb-2">

                        <strong>
                            سخنران:
                        </strong>

                        @Model.Speaker.Name

                    </div>
                }


                @if (!string.IsNullOrWhiteSpace(Model.FileName))
                {
                    <div>

                        <strong>
                            فایل:
                        </strong>

                        موجود

                    </div>
                }

            </div>


            <form asp-area="Admin"
                  asp-controller="AudioFiles"
                  asp-action="Delete"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.Id" />


                <div class="d-flex gap-2">

                    <a asp-area="Admin"
                       asp-controller="AudioFiles"
                       asp-action="Index"
                       class="btn btn-secondary">

                        انصراف

                    </a>


                    <button type="submit"
                            class="btn btn-danger">

                        حذف فایل صوتی

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>
