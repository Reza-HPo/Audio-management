@model MaktabAhvaz.Domain.Entities.NavigationItem

@{
    ViewData["Title"] = "ویرایش آیتم منو";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">

    <div class="mb-4">
        <h1 class="h3 mb-1">ویرایش آیتم منو</h1>
        <p class="text-muted mb-0">
            اطلاعات آیتم منوی انتخاب‌شده را ویرایش کنید.
        </p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <form asp-action="Edit" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"
                     role="alert"></div>

                <div class="row g-4">

                    <!-- Title -->
                    <div class="col-md-6">
                        <label asp-for="Title" class="form-label">
                            عنوان منو
                        </label>

                        <input asp-for="Title"
                               class="form-control"
                               placeholder="مثلاً صفحه اصلی" />

                        <span asp-validation-for="Title"
                              class="text-danger"></span>
                    </div>

                    <!-- Url -->
                    <div class="col-md-6">
                        <label asp-for="Url" class="form-label">
                            آدرس
                        </label>

                        <input asp-for="Url"
                               class="form-control"
                               placeholder="مثلاً / یا /audios" />

                        <span asp-validation-for="Url"
                              class="text-danger"></span>

                        <div class="form-text">
                            برای صفحات داخلی از مسیرهایی مانند
                            <code>/audios</code>
                            استفاده کنید.
                        </div>
                    </div>

                    <!-- Icon -->
                    <div class="col-md-6">
                        <label asp-for="Icon" class="form-label">
                            آیکون
                        </label>

                        <input asp-for="Icon"
                               class="form-control"
                               placeholder="مثلاً bi bi-house" />

                        <span asp-validation-for="Icon"
                              class="text-danger"></span>

                        <div class="form-text">
                            در صورت استفاده از Bootstrap Icons، کلاس آیکون را وارد کنید.
                        </div>
                    </div>

                    <!-- DisplayOrder -->
                    <div class="col-md-6">
                        <label asp-for="DisplayOrder" class="form-label">
                            ترتیب نمایش
                        </label>

                        <input asp-for="DisplayOrder"
                               type="number"
                               class="form-control"
                               min="0" />

                        <span asp-validation-for="DisplayOrder"
                              class="text-danger"></span>

                        <div class="form-text">
                            عدد کمتر، زودتر نمایش داده می‌شود.
                        </div>
                    </div>

                    <!-- IsActive -->
                    <div class="col-md-6">

                        <div class="form-check form-switch mt-4">

                            <input asp-for="IsActive"
                                   class="form-check-input"
                                   type="checkbox" />

                            <label asp-for="IsActive"
                                   class="form-check-label">
                                آیتم فعال باشد
                            </label>

                        </div>

                    </div>

                    <!-- OpenInNewTab -->
                    <div class="col-md-6">

                        <div class="form-check form-switch mt-4">

                            <input asp-for="OpenInNewTab"
                                   class="form-check-input"
                                   type="checkbox" />

                            <label asp-for="OpenInNewTab"
                                   class="form-check-label">
                                باز شدن در تب جدید
                            </label>

                        </div>

                    </div>

                </div>

                <hr class="my-4" />

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        <i class="bi bi-check-lg"></i>
                        ذخیره تغییرات
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        انصراف
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}