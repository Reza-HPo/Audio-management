@model IEnumerable<MaktabAhvaz.Domain.Entities.Category>

@{
    ViewData["Title"] = "دسته‌بندی‌ها";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="admin-page">

    <!-- Page Header -->

    <div class="admin-page-header">

        <div class="admin-page-heading">

            <div class="admin-page-icon">
                ▦
            </div>

            <div>

                <h1 class="admin-page-title">
                    دسته‌بندی‌ها
                </h1>

                <p class="admin-page-description">
                    مدیریت دسته‌بندی‌های فایل‌های صوتی
                </p>

            </div>

        </div>


        <a asp-area="Admin"
           asp-controller="Categories"
           asp-action="Create"
           class="admin-btn admin-btn-primary">

            <span class="admin-btn-icon">
                +
            </span>

            <span>
                افزودن دسته‌بندی
            </span>

        </a>

    </div>


    <!-- Success Message -->
    @if (TempData["Success"] != null)
    {
        <div class="admin-alert admin-alert-success">

            <span class="admin-alert-icon">
                ✓
            </span>

            <span>
                @TempData["Success"]
            </span>

        </div>
    }


    <!-- Error Message -->
    @if (TempData["Error"] != null)
    {
        <div class="admin-alert admin-alert-danger">

            <span class="admin-alert-icon">
                !
            </span>

            <span>
                @TempData["Error"]
            </span>

        </div>
    }


    <!-- Main Card -->

    <div class="admin-card">

        @if (Model.Any())
        {
            <div class="table-responsive">

                <table class="admin-table">

                    <thead>

                        <tr>

                            <th>
                                دسته‌بندی
                            </th>

                            <th>
                                Slug
                            </th>

                            <th>
                                فایل‌های صوتی
                            </th>

                            <th>
                                وضعیت
                            </th>

                            <th>
                                ترتیب
                            </th>

                            <th class="text-end">
                                عملیات
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var category in Model)
                        {
                            <tr>

                                <!-- Category -->

                                <td>

                                    <div class="category-cell">

                                        <div class="category-icon">
                                            ▦
                                        </div>

                                        <div class="category-info">

                                            <strong class="category-name">
                                                @category.Name
                                            </strong>


                                            @if (!string.IsNullOrWhiteSpace(category.Description))
                                            {
                                                <span class="category-description">

                                                    @{
                                                        var description =
                                                            category.Description.Length > 70
                                                                ? category.Description[..70] + "..."
                                                                : category.Description;
                                                    }

                                                    @description

                                                </span>
                                            }
                                            else
                                            {
                                                <span class="category-description muted">
                                                    توضیحی ثبت نشده
                                                </span>
                                            }

                                        </div>

                                    </div>

                                </td>


                                <!-- Slug -->

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(category.Slug))
                                    {
                                        <code class="category-slug">
                                            @category.Slug
                                        </code>
                                    }
                                    else
                                    {
                                        <span class="admin-muted">
                                            —
                                        </span>
                                    }

                                </td>


                                <!-- Audio Count -->

                                <td>

                                    @if (category.AudioCategories.Any())
                                    {
                                        <span class="category-count">
                                            @category.AudioCategories.Count
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="admin-muted">
                                            ۰ فایل
                                        </span>
                                    }

                                </td>


                                <!-- Status -->

                                <td>

                                    @if (category.IsActive)
                                    {
                                        <span class="admin-status admin-status-success">

                                            <span class="admin-status-dot"></span>

                                            فعال

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="admin-status admin-status-muted">

                                            <span class="admin-status-dot"></span>

                                            غیرفعال

                                        </span>
                                    }

                                </td>


                                <!-- Display Order -->

                                <td>

                                    <span class="category-order">
                                        @category.DisplayOrder
                                    </span>

                                </td>


                                <!-- Actions -->

                                <td class="text-end">

                                    <div class="admin-actions">

                                        <a asp-area="Admin"
                                           asp-controller="Categories"
                                           asp-action="Edit"
                                           asp-route-id="@category.Id"
                                           class="admin-action admin-action-edit">

                                            <span>
                                                ویرایش
                                            </span>

                                        </a>


                                        <a asp-area="Admin"
                                           asp-controller="Categories"
                                           asp-action="Delete"
                                           asp-route-id="@category.Id"
                                           class="admin-action admin-action-delete">

                                            <span>
                                                حذف
                                            </span>

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <!-- Empty State -->

            <div class="admin-empty">

                <div class="admin-empty-icon">
                    ▦
                </div>

                <h3>
                    هنوز دسته‌بندی‌ای ثبت نشده است
                </h3>

                <p>
                    برای مرتب‌سازی فایل‌های صوتی، اولین دسته‌بندی خود را ایجاد کنید.
                </p>


                <a asp-area="Admin"
                   asp-controller="Categories"
                   asp-action="Create"
                   class="admin-btn admin-btn-primary">

                    <span class="admin-btn-icon">
                        +
                    </span>

                    <span>
                        افزودن اولین دسته‌بندی
                    </span>

                </a>

            </div>
        }

    </div>

</div>