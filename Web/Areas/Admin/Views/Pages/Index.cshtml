@model IEnumerable<MaktabAhvaz.Domain.Entities.Page>

@{
    ViewData["Title"] = "مدیریت صفحات";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">مدیریت صفحات</h1>
            <p class="text-muted mb-0">
                مدیریت صفحات محتوایی سایت
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i>
            افزودن صفحه
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">

            @if (Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>عنوان</th>
                                <th>Slug</th>
                                <th>وضعیت</th>
                                <th>تاریخ ایجاد</th>
                                <th>آخرین ویرایش</th>
                                <th style="width: 190px;">عملیات</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        <strong>@item.Title</strong>
                                    </td>

                                    <td>
                                        <code>
                                            /@item.Slug
                                        </code>
                                    </td>

                                    <td>
                                        @if (item.IsPublished)
                                        {
                                            <span class="badge bg-success">
                                                منتشر شده
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                پیش‌نویس
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @item.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd")
                                    </td>

                                    <td>
                                        @if (item.UpdatedAt.HasValue)
                                        {
                                            @item.UpdatedAt.Value.ToLocalTime().ToString("yyyy/MM/dd")
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <div class="d-flex gap-2">

                                            <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                ویرایش
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-danger">
                                                حذف
                                            </a>

                                        </div>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <div class="mb-3">
                        <i class="bi bi-file-earmark-text fs-1 text-muted"></i>
                    </div>

                    <h5>
                        هنوز صفحه‌ای ایجاد نشده است.
                    </h5>

                    <p class="text-muted">
                        اولین صفحه محتوایی سایت را ایجاد کنید.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-primary">
                        افزودن اولین صفحه
                    </a>

                </div>
            }

        </div>
    </div>

</div>