<header class="site-header">
    <div class="container">
        <nav class="navbar navbar-expand-lg main-navbar">

            <!-- Brand -->
            <a class="navbar-brand site-brand"
               asp-controller="Home"
               asp-action="Index">

                <span class="brand-mark">
                    <span>م</span>
                </span>

                <span class="brand-content">
                    <strong>مجالس اهواز</strong>
                    <small>آرشیو صوتی مجالس و سخنرانی‌ها</small>
                </span>

            </a>


            <!-- Mobile Button -->
            <button class="navbar-toggler custom-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar"
                    aria-expanded="false"
                    aria-label="باز کردن منو">

                <span></span>
                <span></span>
                <span></span>

            </button>


            <!-- Navigation -->
            <div class="collapse navbar-collapse"
                 id="mainNavbar">

                <ul class="navbar-nav main-nav">

                    <!-- Home -->
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                           asp-controller="Home"
                           asp-action="Index">

                            <span>خانه</span>

                        </a>
                    </li>


                    <!-- Archive -->
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Archive" ? "active" : "")"
                           asp-controller="Archive"
                           asp-action="Index">

                            <span>آرشیو صوتی</span>

                        </a>
                    </li>


                    <!-- Speakers -->
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Speakers" ? "active" : "")"
                           asp-controller="Speakers"
                           asp-action="Index">

                            <span>سخنران‌ها</span>

                        </a>
                    </li>


                    <!-- Categories -->
                    <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Categories" ? "active" : "")"
                              asp-controller="Categories"
                              asp-action="Index">
                              <span>دسته‌بندی‌ها</span>
                            </a>
                     </li>


                    <!-- About -->
                    <li class="nav-item">
                        <a class="nav-link"
                           href="#">

                            <span>درباره ما</span>

                        </a>
                    </li>

                </ul>


                <!-- Header Actions -->
                <div class="header-actions">

                    <!-- Search -->
                    <button class="search-button"
                            type="button"
                            aria-label="جستجو">

                        <span class="search-icon"></span>

                    </button>


                    <!-- Archive -->
                    <a class="header-archive-button"
                       asp-controller="Archive"
                       asp-action="Index">

                        <span>مشاهده آرشیو</span>

                        <span class="arrow">←</span>

                    </a>

                </div>

            </div>

        </nav>
    </div>
</header>