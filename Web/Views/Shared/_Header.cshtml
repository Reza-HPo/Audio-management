<header class="site-header">

    <div class="container">

        <nav class="navbar navbar-expand-lg main-navbar">

            <!-- =====================================================
                 BRAND
            ====================================================== -->

            <a class="navbar-brand site-brand"
               asp-controller="Home"
               asp-action="Index"
               aria-label="صفحه اصلی مجالس اهواز">

                <span class="brand-mark">
                    <span>م</span>
                </span>

                <span class="brand-content">

                    <strong>
                        مجالس اهواز
                    </strong>

                    <small>
                        آرشیو صوتی مجالس و سخنرانی‌ها
                    </small>

                </span>

            </a>


            <!-- =====================================================
                 MOBILE TOGGLE
            ====================================================== -->

            <button class="navbar-toggler custom-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar"
                    aria-expanded="false"
                    aria-label="باز کردن منو">

                <span></span>
                <span></span>
                <span></span>

            </button>


            <!-- =====================================================
                 NAVIGATION
            ====================================================== -->

            <div class="collapse navbar-collapse"
                 id="mainNavbar">


                <!-- =================================================
                     MAIN NAVIGATION
                ================================================== -->

                <ul class="navbar-nav main-nav">


                    <!-- Home -->

                    <li class="nav-item">

                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                           asp-controller="Home"
                           asp-action="Index">

                            <span>
                                خانه
                            </span>

                        </a>

                    </li>


                    <!-- Archive -->

                    <li class="nav-item">

                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Archive" ? "active" : "")"
                           asp-controller="Archive"
                           asp-action="Index">

                            <span>
                                آرشیو صوتی
                            </span>

                        </a>

                    </li>


                    <!-- Speakers -->

                    <li class="nav-item">

                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Speakers" ? "active" : "")"
                           asp-controller="Speakers"
                           asp-action="Index">

                            <span>
                                سخنران‌ها
                            </span>

                        </a>

                    </li>


                    <!-- Categories -->

                    <li class="nav-item">

                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Categories" ? "active" : "")"
                           asp-controller="Categories"
                           asp-action="Index">

                            <span>
                                دسته‌بندی‌ها
                            </span>

                        </a>

                    </li>


                    <!-- About -->

                    <li class="nav-item">

                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "About" ? "active" : "")"
                           asp-controller="About"
                           asp-action="Index">

                            <span>
                                درباره ما
                            </span>

                        </a>

                    </li>

                </ul>


                <!-- =================================================
                     HEADER ACTIONS
                ================================================== -->

                <div class="header-actions">


                    <!-- Search -->

                    <button class="search-button"
                            type="button"
                            aria-label="جستجو">

                        <span class="search-icon"></span>

                    </button>


                    <!-- Archive CTA -->

                    <a class="header-archive-button"
                       asp-controller="Archive"
                       asp-action="Index">

                        <span>
                            مشاهده آرشیو
                        </span>

                        <span class="arrow">
                            ←
                        </span>

                    </a>

                </div>

            </div>


            <!-- =====================================================
                 NOTICES
                 خارج از Collapse
            ====================================================== -->

            <div class="header-notices">

                <a class="header-notice-button
                          @(ViewContext.RouteData.Values["controller"]?.ToString() == "Notices"
                              ? "active"
                              : "")"
                   asp-controller="Notices"
                   asp-action="Index"
                   aria-label="اطلاعیه‌ها">


                    <!-- Notice Icon -->

                    <span class="header-notice-icon">

                        <i class="bi bi-megaphone-fill"
                           aria-hidden="true"></i>

                    </span>


                    <!-- Notice Content -->

                    <span class="header-notice-content">

                        <strong>
                            اطلاعیه‌ها
                        </strong>

                        <small>
                            اطلاعیه‌های جدید
                        </small>

                    </span>


                    <!-- Notice Arrow -->

                    <span class="header-notice-arrow"
                          aria-hidden="true">

                        ←

                    </span>

                </a>

            </div>

        </nav>

    </div>

</header>