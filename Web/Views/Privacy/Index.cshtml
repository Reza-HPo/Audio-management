@{
    ViewData["Title"] = "حریم خصوصی";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/privacy.css"
          asp-append-version="true" />
}

<main class="privacy-page">

    <!-- =====================================================
         HERO
    ====================================================== -->

    <section class="privacy-hero">

        <div class="privacy-container">

            <div class="privacy-hero-content">

                <span class="privacy-eyebrow">

                    <i class="bi bi-shield-lock"></i>

                    حریم خصوصی

                </span>

                <h1>

                    حریم خصوصی
                    <span>کاربران</span>

                </h1>

                <p>

                    حفظ حریم خصوصی و اطلاعات کاربران برای
                    «مجالس اهواز» اهمیت دارد. در این صفحه توضیح
                    داده‌ایم که هنگام استفاده از سایت چه اطلاعاتی
                    ممکن است در اختیار ما قرار گیرد و نحوه برخورد
                    با این اطلاعات چگونه است.

                </p>

            </div>


            <div class="privacy-hero-icon">

                <div class="privacy-icon-glow"></div>

                <div class="privacy-icon-card">

                    <i class="bi bi-shield-check"></i>

                </div>

            </div>

        </div>

    </section>


    <!-- =====================================================
         CONTENT
    ====================================================== -->

    <section class="privacy-section">

        <div class="privacy-container">

            <div class="privacy-layout">


                <!-- =================================================
                     SIDEBAR
                ================================================== -->

                <aside class="privacy-sidebar">

                    <div class="privacy-sidebar-card">

                        <div class="privacy-sidebar-heading">

                            <span class="privacy-sidebar-icon">

                                <i class="bi bi-list-ul"></i>

                            </span>

                            <div>

                                <strong>
                                    فهرست مطالب
                                </strong>

                                <small>
                                    دسترسی سریع
                                </small>

                            </div>

                        </div>


                        <nav class="privacy-navigation"
                             aria-label="فهرست حریم خصوصی">

                            <a href="#overview">

                                <span>۰۱</span>

                                مقدمه

                            </a>

                            <a href="#information">

                                <span>۰۲</span>

                                اطلاعات کاربران

                            </a>

                            <a href="#usage">

                                <span>۰۳</span>

                                نحوه استفاده

                            </a>

                            <a href="#technical">

                                <span>۰۴</span>

                                اطلاعات فنی

                            </a>

                            <a href="#sharing">

                                <span>۰۵</span>

                                اشتراک‌گذاری اطلاعات

                            </a>

                            <a href="#security">

                                <span>۰۶</span>

                                امنیت اطلاعات

                            </a>

                            <a href="#third-party">

                                <span>۰۷</span>

                                خدمات شخص ثالث

                            </a>

                            <a href="#changes">

                                <span>۰۸</span>

                                تغییرات سیاست

                            </a>

                            <a href="#contact">

                                <span>۰۹</span>

                                ارتباط با ما

                            </a>

                        </nav>

                    </div>

                </aside>


                <!-- =================================================
                     MAIN CONTENT
                ================================================== -->

                <article class="privacy-content">


                    <!-- =================================================
                         INTRO
                    ================================================== -->

                    <div class="privacy-intro"
                         id="overview">

                        <div class="privacy-intro-icon">

                            <i class="bi bi-info-circle"></i>

                        </div>

                        <div>

                            <strong>
                                درباره این سیاست
                            </strong>

                            <p>

                                این صفحه برای اطلاع‌رسانی درباره
                                نحوه برخورد «مجالس اهواز» با اطلاعات
                                کاربران تهیه شده است. استفاده از سایت
                                به معنای مطالعه این سیاست و آگاهی از
                                مفاد آن است.

                            </p>

                        </div>

                    </div>


                    <!-- =================================================
                         01
                    ================================================== -->

                    <section class="privacy-block"
                             id="information">

                        <div class="privacy-block-number">
                            ۰۱
                        </div>

                        <div class="privacy-block-content">

                            <span class="privacy-block-label">
                                اطلاعات کاربران
                            </span>

                            <h2>
                                چه اطلاعاتی ممکن است دریافت شود؟
                            </h2>

                            <p>

                                در حالت عادی، برای مشاهده و استفاده
                                از بخش‌های عمومی وب‌سایت «مجالس اهواز»
                                نیازی به ایجاد حساب کاربری یا ارائه
                                اطلاعات شخصی وجود ندارد.

                            </p>

                            <p>

                                در صورتی که کاربر از فرم ارتباط با ما
                                استفاده کند، ممکن است اطلاعاتی مانند
                                نام، نشانی ایمیل، موضوع پیام و متن پیام
                                را در اختیار مجموعه قرار دهد.

                            </p>

                            <div class="privacy-note">

                                <i class="bi bi-person-check"></i>

                                <p>

                                    اطلاعاتی که هنگام ارتباط با مجموعه
                                    ارائه می‌کنید باید تا حد امکان صحیح
                                    و مربوط به خود شما باشد.

                                </p>

                            </div>

                        </div>

                    </section>


                    <!-- =================================================
                         02
                    ================================================== -->

                    <section class="privacy-block"
                             id="usage">

                        <div class="privacy-block-number">
                            ۰۲
                        </div>

                        <div class="privacy-block-content">

                            <span class="privacy-block-label">
                                استفاده از اطلاعات
                            </span>

                            <h2>
                                اطلاعات دریافت‌شده چگونه استفاده می‌شوند؟
                            </h2>

                            <p>

                                اطلاعاتی که کاربر مستقیماً در اختیار
                                «مجالس اهواز» قرار می‌دهد، در حد نیاز
                                برای پاسخ‌گویی، پیگیری درخواست‌ها،
                                ارتباط با کاربر و ارائه خدمات مرتبط
                                با سایت مورد استفاده قرار می‌گیرد.

                            </p>

                            <ul class="privacy-list">

                                <li>

                                    <i class="bi bi-check2"></i>

                                    <span>
                                        پاسخ‌گویی به پیام‌ها و درخواست‌های
                                        ارسال‌شده از طریق فرم ارتباط با ما.
                                    </span>

                                </li>

                                <li>

                                    <i class="bi bi-check2"></i>

                                    <span>
                                        پیگیری موضوعات مرتبط با محتوا
                                        و عملکرد وب‌سایت.
                                    </span>

                                </li>

                                <li>

                                    <i class="bi bi-check2"></i>

                                    <span>
                                        بررسی و بهبود کیفیت خدمات و
                                        تجربه استفاده از سایت.
                                    </span>

                                </li>

                            </ul>

                        </div>

                    </section>


                    <!-- =================================================
                         03
                    ================================================== -->

                    <section class="privacy-block"
                             id="technical">

                        <div class="privacy-block-number">
                            ۰۳
                        </div>

                        <div class="privacy-block-content">

                            <span class="privacy-block-label">
                                اطلاعات فنی
                            </span>

                            <h2>
                                اطلاعات فنی و لاگ‌های سرویس
                            </h2>

                            <p>

                                مانند بسیاری از وب‌سایت‌ها، ممکن است
                                زیرساخت فنی و سرویس میزبانی اطلاعاتی
                                مربوط به درخواست‌های وب را در قالب
                                لاگ‌های فنی ثبت کند.

                            </p>

                            <p>

                                این اطلاعات می‌تواند بسته به تنظیمات
                                سرویس میزبانی و زیرساخت شامل مواردی
                                مانند نشانی IP، زمان درخواست، نوع
                                مرورگر، سیستم‌عامل یا اطلاعات فنی
                                مشابه باشد.

                            </p>

                            <div class="privacy-note">

                                <i class="bi bi-server"></i>

                                <p>

                                    میزان و نوع اطلاعات فنی ثبت‌شده
                                    به تنظیمات واقعی سرور، میزبان و
                                    سرویس‌های مورد استفاده بستگی دارد.

                                </p>

                            </div>

                        </div>

                    </section>


                    <!-- =================================================
                         04
                    ================================================== -->

                    <section class="privacy-block"
                             id="sharing">

                        <div class="privacy-block-number">
                            ۰۴
                        </div>

                        <div class="privacy-block-content">

                            <span class="privacy-block-label">
                                محرمانگی
                            </span>

                            <h2>
                                اشتراک‌گذاری اطلاعات
                            </h2>

                            <p>

                                اطلاعاتی که کاربران از طریق راه‌های
                                ارتباطی سایت در اختیار «مجالس اهواز»
                                قرار می‌دهند، صرفاً در چارچوب نیازهای
                                مرتبط با ارائه خدمات، پاسخ‌گویی و
                                مدیریت سایت مورد استفاده قرار می‌گیرند.

                            </p>

                            <p>

                                اطلاعات شخصی کاربران بدون مبنای مشخص
                                و ضرورت مرتبط با خدمات، در اختیار
                                اشخاص یا مجموعه‌های دیگر قرار نخواهد
                                گرفت.

                            </p>

                            <ul class="privacy-list">

                                <li>

                                    <i class="bi bi-check2"></i>

                                    <span>
                                        اطلاعات کاربران برای فروش یا
                                        تبلیغات شخص ثالث در اختیار
                                        دیگران قرار نمی‌گیرد.
                                    </span>

                                </li>

                                <li>

                                    <i class="bi bi-check2"></i>

                                    <span>
                                        در صورت وجود الزام قانونی،
                                        اطلاعات ممکن است مطابق قوانین
                                        و مقررات مربوطه مورد رسیدگی قرار گیرد.
                                    </span>

                                </li>

                            </ul>

                        </div>

                    </section>


                    <!-- =================================================
                         05
                    ================================================== -->

                    <section class="privacy-block"
                             id="security">

                        <div class="privacy-block-number">
                            ۰۵
                        </div>

                        <div class="privacy-block-content">

                            <span class="privacy-block-label">
                                امنیت
                            </span>

                            <h2>
                                امنیت اطلاعات
                            </h2>

                            <p>

                                «مجالس اهواز» تلاش می‌کند با استفاده
                                از اقدامات فنی و مدیریتی متناسب،
                                از اطلاعاتی که در اختیار مجموعه قرار
                                می‌گیرد در برابر دسترسی یا استفاده
                                غیرمجاز محافظت کند.

                            </p>

                            <p>

                                با این حال، هیچ سرویس اینترنتی را
                                نمی‌توان به‌طور مطلق در برابر تمام
                                تهدیدهای امنیتی تضمین کرد. کاربران
                                نیز باید هنگام ارسال اطلاعات در
                                اینترنت، ملاحظات امنیتی لازم را رعایت کنند.

                            </p>

                        </div>

                    </section>


                    <!-- =================================================
                         06
                    ================================================== -->

                    <section class="privacy-block"
                             id="third-party">

                        <div class="privacy-block-number">
                            ۰۶
                        </div>

                        <div class="privacy-block-content">

                            <span class="privacy-block-label">
                                سرویس‌های بیرونی
                            </span>

                            <h2>
                                لینک‌ها و خدمات شخص ثالث
                            </h2>

                            <p>

                                ممکن است در بخش‌هایی از وب‌سایت
                                «مجالس اهواز» لینک‌هایی به سرویس‌ها
                                یا صفحات متعلق به اشخاص و مجموعه‌های
                                دیگر ارائه شود.

                            </p>

                            <p>

                                از جمله این موارد می‌توان به
                                پیام‌رسان‌هایی مانند ایتا، تلگرام
                                و بله اشاره کرد.

                            </p>

                            <div class="privacy-note">

                                <i class="bi bi-box-arrow-up-left"></i>

                                <p>

                                    پس از ورود به سرویس‌های دیگر،
                                    استفاده شما از اطلاعات و امکانات
                                    آن سرویس‌ها تابع سیاست‌ها و
                                    مقررات همان سرویس خواهد بود.

                                </p>

                            </div>

                        </div>

                    </section>


                    <!-- =================================================
                         07
                    ================================================== -->

                    <section class="privacy-block"
                             id="changes">

                        <div class="privacy-block-number">
                            ۰۷
                        </div>

                        <div class="privacy-block-content">

                            <span class="privacy-block-label">
                                به‌روزرسانی
                            </span>

                            <h2>
                                تغییرات این سیاست
                            </h2>

                            <p>

                                ممکن است با توجه به تغییر امکانات
                                وب‌سایت، شرایط فنی یا نحوه ارائه
                                خدمات، این سیاست حریم خصوصی در آینده
                                به‌روزرسانی شود.

                            </p>

                            <p>

                                نسخه جدید پس از انتشار در همین صفحه
                                قابل مشاهده خواهد بود. توصیه می‌شود
                                کاربران در صورت استفاده مستمر از سایت،
                                این صفحه را هر از گاهی بررسی کنند.

                            </p>

                        </div>

                    </section>


                    <!-- =================================================
                         08
                    ================================================== -->

                    <section class="privacy-block"
                             id="contact">

                        <div class="privacy-block-number">
                            ۰۸
                        </div>

                        <div class="privacy-block-content">

                            <span class="privacy-block-label">
                                ارتباط با مجموعه
                            </span>

                            <h2>
                                پرسش یا درخواست درباره حریم خصوصی
                            </h2>

                            <p>

                                اگر درباره نحوه برخورد با اطلاعات،
                                مفاد این سیاست یا موضوعی مرتبط با
                                حریم خصوصی پرسشی دارید، می‌توانید
                                از طریق راه‌های ارتباطی زیر با
                                «مجالس اهواز» در تماس باشید.

                            </p>


                            <div class="privacy-contact-grid">

                                <a href="mailto:info@maktabahwaz.ir"
                                   class="privacy-contact-card">

                                    <span class="privacy-contact-icon">

                                        <i class="bi bi-envelope"></i>

                                    </span>

                                    <span>

                                        <small>
                                            ایمیل عمومی
                                        </small>

                                        <strong>
                                            info@maktabahwaz.ir
                                        </strong>

                                    </span>

                                </a>


                                <a href="mailto:Official@maktabahwaz.ir"
                                   class="privacy-contact-card">

                                    <span class="privacy-contact-icon">

                                        <i class="bi bi-envelope-paper"></i>

                                    </span>

                                    <span>

                                        <small>
                                            ارتباط رسمی
                                        </small>

                                        <strong>
                                            Official@maktabahwaz.ir
                                        </strong>

                                    </span>

                                </a>

                            </div>

                        </div>

                    </section>


                    <!-- =================================================
                         LAST UPDATE
                    ================================================== -->

                    <div class="privacy-updated">

                        <i class="bi bi-clock-history"></i>

                        <span>
                            آخرین به‌روزرسانی این صفحه:
                        </span>

                        <strong>
                            مهر ۱۴۰۵
                        </strong>

                    </div>

                </article>

            </div>

        </div>

    </section>


    <!-- =====================================================
         FINAL CTA
    ====================================================== -->

    <section class="privacy-final">

        <div class="privacy-container">

            <div class="privacy-final-inner">

                <div class="privacy-final-icon">

                    <i class="bi bi-collection-play"></i>

                </div>


                <div class="privacy-final-content">

                    <span>
                        با خیال راحت از آرشیو استفاده کنید
                    </span>

                    <h2>
                        آرشیو صوتی مجالس اهواز
                    </h2>

                    <p>

                        مجموعه فایل‌های صوتی و سخنرانی‌های موجود
                        در آرشیو را مشاهده و استفاده کنید.

                    </p>

                </div>


                <a class="privacy-final-button"
                   asp-controller="Archive"
                   asp-action="Index">

                    <span>
                        مشاهده آرشیو
                    </span>

                    <i class="bi bi-arrow-left"></i>

                </a>

            </div>

        </div>

    </section>

</main>