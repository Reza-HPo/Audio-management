@{
    ViewData["Title"] = "قوانین و مقررات";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/terms.css"
          asp-append-version="true" />
}

<main class="terms-page">

    <!-- =========================================================
         HERO
    ========================================================== -->

    <section class="terms-hero">

        <div class="terms-container">

            <div class="terms-hero-content">

                <span class="terms-eyebrow">
                    <i class="bi bi-shield-check"></i>
                    قوانین و مقررات
                </span>

                <h1>
                    شرایط استفاده از
                    <span>مجالس اهواز</span>
                </h1>

                <p>
                    این صفحه شرایط و ضوابط استفاده از وب‌سایت،
                    آرشیو صوتی و خدمات ارائه‌شده توسط
                    «مجالس اهواز» را توضیح می‌دهد.
                </p>

            </div>

            <div class="terms-hero-icon">

                <div class="terms-icon-glow"></div>

                <div class="terms-icon-card">
                    <i class="bi bi-file-earmark-text"></i>
                </div>

            </div>

        </div>

    </section>


    <!-- =========================================================
         CONTENT
    ========================================================== -->

    <section class="terms-section">

        <div class="terms-container">

            <div class="terms-layout">


                <!-- =================================================
                     SIDEBAR
                ================================================== -->

                <aside class="terms-sidebar">

                    <div class="terms-sidebar-card">

                        <div class="terms-sidebar-heading">

                            <span class="terms-sidebar-icon">
                                <i class="bi bi-list-ul"></i>
                            </span>

                            <div>
                                <strong>
                                    فهرست مطالب
                                </strong>

                                <small>
                                    دسترسی سریع
                                </small>
                            </div>

                        </div>


                        <nav class="terms-navigation"
                             aria-label="فهرست قوانین">

                            <a href="#acceptance">
                                <span>۰۱</span>
                                پذیرش قوانین
                            </a>

                            <a href="#content">
                                <span>۰۲</span>
                                استفاده از محتوا
                            </a>

                            <a href="#copyright">
                                <span>۰۳</span>
                                مالکیت معنوی
                            </a>

                            <a href="#user-responsibility">
                                <span>۰۴</span>
                                مسئولیت کاربران
                            </a>

                            <a href="#communication">
                                <span>۰۵</span>
                                ارتباط با ما
                            </a>

                            <a href="#third-party">
                                <span>۰۶</span>
                                خدمات شخص ثالث
                            </a>

                            <a href="#changes">
                                <span>۰۷</span>
                                تغییر قوانین
                            </a>

                            <a href="#contact">
                                <span>۰۸</span>
                                تماس با ما
                            </a>

                        </nav>

                    </div>

                </aside>


                <!-- =================================================
                     MAIN CONTENT
                ================================================== -->

                <article class="terms-content">


                    <!-- Intro -->

                    <div class="terms-intro">

                        <div class="terms-intro-icon">
                            <i class="bi bi-info-circle"></i>
                        </div>

                        <div>

                            <strong>
                                پیش از استفاده از سایت
                            </strong>

                            <p>
                                لطفاً این قوانین را با دقت مطالعه کنید.
                                استفاده، مرور یا دریافت محتوا از وب‌سایت
                                «مجالس اهواز» به معنای مطالعه و پذیرش
                                مفاد این صفحه است.
                            </p>

                        </div>

                    </div>


                    <!-- =================================================
                         01
                    ================================================== -->

                    <section class="terms-block"
                             id="acceptance">

                        <div class="terms-block-number">
                            ۰۱
                        </div>

                        <div class="terms-block-content">

                            <span class="terms-block-label">
                                شرایط عمومی
                            </span>

                            <h2>
                                پذیرش قوانین و مقررات
                            </h2>

                            <p>
                                وب‌سایت «مجالس اهواز» با هدف فراهم کردن
                                دسترسی آسان‌تر به مجموعه‌ای از فایل‌های
                                صوتی، سخنرانی‌ها و محتوای مرتبط با مجالس
                                فعالیت می‌کند.
                            </p>

                            <p>
                                استفاده از بخش‌های مختلف سایت، مشاهده
                                صفحات، جست‌وجو و استفاده از امکانات
                                ارائه‌شده به منزله پذیرش این شرایط و
                                مقررات است.
                            </p>

                        </div>

                    </section>


                    <!-- =================================================
                         02
                    ================================================== -->

                    <section class="terms-block"
                             id="content">

                        <div class="terms-block-number">
                            ۰۲
                        </div>

                        <div class="terms-block-content">

                            <span class="terms-block-label">
                                آرشیو صوتی
                            </span>

                            <h2>
                                استفاده از محتوای سایت
                            </h2>

                            <p>
                                محتوای صوتی موجود در آرشیو برای استفاده
                                کاربران و دسترسی آسان‌تر به مطالب
                                ارائه شده است.
                            </p>

                            <ul class="terms-list">

                                <li>
                                    <i class="bi bi-check2"></i>

                                    <span>
                                        استفاده از محتوای سایت باید در
                                        چارچوب قوانین و مقررات جاری انجام شود.
                                    </span>
                                </li>

                                <li>
                                    <i class="bi bi-check2"></i>

                                    <span>
                                        کاربران نباید از امکانات سایت برای
                                        فعالیت‌های غیرقانونی یا آسیب‌رسان
                                        استفاده کنند.
                                    </span>
                                </li>

                                <li>
                                    <i class="bi bi-check2"></i>

                                    <span>
                                        استفاده از فایل‌ها نباید موجب ایجاد
                                        اختلال یا فشار غیرمتعارف بر سرویس
                                        و زیرساخت سایت شود.
                                    </span>
                                </li>

                            </ul>

                        </div>

                    </section>


                    <!-- =================================================
                         03
                    ================================================== -->

                    <section class="terms-block"
                             id="copyright">

                        <div class="terms-block-number">
                            ۰۳
                        </div>

                        <div class="terms-block-content">

                            <span class="terms-block-label">
                                حقوق محتوا
                            </span>

                            <h2>
                                مالکیت معنوی و حقوق محتوا
                            </h2>

                            <p>
                                محتوای منتشرشده در «مجالس اهواز» ممکن است
                                متعلق به مجموعه، تولیدکنندگان، سخنرانان،
                                برگزارکنندگان مجالس یا سایر صاحبان حقوق
                                مربوط به آن محتوا باشد.
                            </p>

                            <p>
                                انتشار یا دسترسی به یک فایل در سایت به
                                معنای انتقال مالکیت یا اعطای حقوق انحصاری
                                نسبت به آن محتوا نیست.
                            </p>

                            <div class="terms-note">

                                <i class="bi bi-exclamation-circle"></i>

                                <p>
                                    در صورت وجود ادعا یا درخواست مرتبط با
                                    حقوق یک محتوا، می‌توانید موضوع را از
                                    طریق صفحه
                                    <a asp-controller="Contact"
                                       asp-action="Index">
                                        ارتباط با ما
                                    </a>
                                    مطرح کنید تا بررسی شود.
                                </p>

                            </div>

                        </div>

                    </section>


                    <!-- =================================================
                         04
                    ================================================== -->

                    <section class="terms-block"
                             id="user-responsibility">

                        <div class="terms-block-number">
                            ۰۴
                        </div>

                        <div class="terms-block-content">

                            <span class="terms-block-label">
                                مسئولیت استفاده
                            </span>

                            <h2>
                                مسئولیت کاربران
                            </h2>

                            <p>
                                هر کاربر مسئول استفاده‌ای است که از
                                وب‌سایت و امکانات آن انجام می‌دهد.
                            </p>

                            <p>
                                کاربران نباید از سایت برای ارسال، انتشار،
                                ذخیره یا انتقال محتوایی استفاده کنند که
                                مغایر با قوانین، حقوق دیگران یا امنیت
                                سرویس باشد.
                            </p>

                            <ul class="terms-list">

                                <li>
                                    <i class="bi bi-check2"></i>

                                    <span>
                                        احترام به حقوق سایر کاربران و صاحبان
                                        محتوا الزامی است.
                                    </span>
                                </li>

                                <li>
                                    <i class="bi bi-check2"></i>

                                    <span>
                                        تلاش برای ایجاد اختلال در عملکرد
                                        سایت یا سرویس‌های آن مجاز نیست.
                                    </span>
                                </li>

                                <li>
                                    <i class="bi bi-check2"></i>

                                    <span>
                                        استفاده از روش‌های خودکار یا مخرب
                                        برای آسیب به زیرساخت سایت مجاز نیست.
                                    </span>
                                </li>

                            </ul>

                        </div>

                    </section>


                    <!-- =================================================
                         05
                    ================================================== -->

                    <section class="terms-block"
                             id="communication">

                        <div class="terms-block-number">
                            ۰۵
                        </div>

                        <div class="terms-block-content">

                            <span class="terms-block-label">
                                ارتباط با مجموعه
                            </span>

                            <h2>
                                ارسال پیام و درخواست
                            </h2>

                            <p>
                                کاربران می‌توانند از طریق فرم ارتباط با ما
                                یا راه‌های ارتباطی معرفی‌شده در سایت،
                                پرسش‌ها، پیشنهادها، انتقادها و درخواست‌های
                                خود را ارسال کنند.
                            </p>

                            <p>
                                اطلاعاتی که کاربر هنگام ارسال پیام ارائه
                                می‌کند باید تا حد امکان صحیح و متعلق به
                                خود او باشد.
                            </p>

                            <a class="terms-action"
                               asp-controller="Contact"
                               asp-action="Index">

                                <span>
                                    ارتباط با ما
                                </span>

                                <i class="bi bi-arrow-left"></i>

                            </a>

                        </div>

                    </section>


                    <!-- =================================================
                         06
                    ================================================== -->

                    <section class="terms-block"
                             id="third-party">

                        <div class="terms-block-number">
                            ۰۶
                        </div>

                        <div class="terms-block-content">

                            <span class="terms-block-label">
                                سرویس‌های بیرونی
                            </span>

                            <h2>
                                لینک‌ها و خدمات شخص ثالث
                            </h2>

                            <p>
                                ممکن است در بخش‌هایی از سایت، لینک یا
                                دسترسی به خدمات و صفحات متعلق به اشخاص،
                                سازمان‌ها یا سرویس‌های دیگر ارائه شود.
                            </p>

                            <p>
                                این لینک‌ها صرفاً برای سهولت دسترسی کاربران
                                ارائه می‌شوند و شرایط، سیاست‌ها و عملکرد
                                سرویس‌های شخص ثالث تابع مقررات همان سرویس‌ها
                                خواهد بود.
                            </p>

                        </div>

                    </section>


                    <!-- =================================================
                         07
                    ================================================== -->

                    <section class="terms-block"
                             id="changes">

                        <div class="terms-block-number">
                            ۰۷
                        </div>

                        <div class="terms-block-content">

                            <span class="terms-block-label">
                                به‌روزرسانی
                            </span>

                            <h2>
                                تغییر و به‌روزرسانی قوانین
                            </h2>

                            <p>
                                ممکن است با توجه به تغییر امکانات سایت،
                                شرایط فنی یا الزامات مرتبط، مفاد این صفحه
                                در آینده به‌روزرسانی شود.
                            </p>

                            <p>
                                نسخه جدید قوانین پس از انتشار در همین صفحه
                                قابل مشاهده خواهد بود. ادامه استفاده از
                                سایت پس از اعمال تغییرات، به معنای پذیرش
                                نسخه به‌روزشده قوانین خواهد بود.
                            </p>

                        </div>

                    </section>


                    <!-- =================================================
                         08
                    ================================================== -->

                    <section class="terms-block"
                             id="contact">

                        <div class="terms-block-number">
                            ۰۸
                        </div>

                        <div class="terms-block-content">

                            <span class="terms-block-label">
                                پشتیبانی و ارتباط
                            </span>

                            <h2>
                                پرسش درباره قوانین
                            </h2>

                            <p>
                                اگر درباره مفاد این قوانین، نحوه استفاده
                                از محتوای سایت یا موضوعی مرتبط با حقوق
                                محتوا پرسشی دارید، می‌توانید با مجموعه
                                «مجالس اهواز» در ارتباط باشید.
                            </p>

                            <div class="terms-contact-grid">

                                <a href="mailto:info@maktabahwaz.ir"
                                   class="terms-contact-card">

                                    <span class="terms-contact-icon">
                                        <i class="bi bi-envelope"></i>
                                    </span>

                                    <span>

                                        <small>
                                            ایمیل عمومی
                                        </small>

                                        <strong>
                                            info@maktabahwaz.ir
                                        </strong>

                                    </span>

                                </a>


                                <a href="mailto:Official@maktabahwaz.ir"
                                   class="terms-contact-card">

                                    <span class="terms-contact-icon">
                                        <i class="bi bi-envelope-paper"></i>
                                    </span>

                                    <span>

                                        <small>
                                            ارتباط رسمی
                                        </small>

                                        <strong>
                                            Official@maktabahwaz.ir
                                        </strong>

                                    </span>

                                </a>

                            </div>

                        </div>

                    </section>


                    <!-- =================================================
                         LAST UPDATE
                    ================================================== -->

                    <div class="terms-updated">

                        <i class="bi bi-clock-history"></i>

                        <span>
                            آخرین به‌روزرسانی این صفحه:
                        </span>

                        <strong>
                            شهریور ۱۴۰۵
                        </strong>

                    </div>


                </article>

            </div>

        </div>

    </section>


    <!-- =========================================================
         FINAL CTA
    ========================================================== -->

    <section class="terms-final">

        <div class="terms-container">

            <div class="terms-final-inner">

                <div class="terms-final-icon">
                    <i class="bi bi-collection-play"></i>
                </div>


                <div class="terms-final-content">

                    <span>
                        آماده استفاده از آرشیو هستید؟
                    </span>

                    <h2>
                        محتوای صوتی مجالس اهواز را مشاهده کنید
                    </h2>

                    <p>
                        به آرشیو صوتی دسترسی پیدا کنید و سخنرانی‌ها
                        و مجالس موجود را مشاهده کنید.
                    </p>

                </div>


                <a class="terms-final-button"
                   asp-controller="Archive"
                   asp-action="Index">

                    <span>
                        مشاهده آرشیو
                    </span>

                    <i class="bi bi-arrow-left"></i>

                </a>

            </div>

        </div>

    </section>

</main>