@model Web.Models.ViewModels.Home.HomeViewModel

@{
    ViewData["Title"] = "خانه";
}

@section Styles {

    <link rel="stylesheet"
          href="~/css/mainpage.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/player.css"
          asp-append-version="true" />
}

<main class="home-page">

    <!-- =====================================================
         HERO
         ===================================================== -->

    <section class="home-hero">

        <div class="home-hero-glow home-hero-glow-one"></div>
        <div class="home-hero-glow home-hero-glow-two"></div>

        <div class="container">

            <div class="home-hero-content">

                <!-- HERO TEXT -->

                <div class="home-hero-text">

                    @if (!string.IsNullOrWhiteSpace(Model.Content.HeroSubtitle))
                    {
                        <span class="home-hero-eyebrow">

                            <span class="home-hero-eyebrow-dot"></span>

                            @Model.Content.HeroSubtitle

                        </span>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Content.HeroTitle))
                    {
                        <h1 class="home-hero-title">
                            @Model.Content.HeroTitle
                        </h1>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Content.HeroDescription))
                    {
                        <p class="home-hero-description">
                            @Model.Content.HeroDescription
                        </p>
                    }

                    <!-- HERO BUTTONS -->

                    <div class="home-hero-actions">

                        @{
                            var heroButtonUrl =
                                string.IsNullOrWhiteSpace(Model.Content.HeroButtonUrl)
                                    ? Url.Action("Index", "Archive")
                                    : Model.Content.HeroButtonUrl;

                            var heroButtonText =
                                string.IsNullOrWhiteSpace(Model.Content.HeroButtonText)
                                    ? "ورود به آرشیو"
                                    : Model.Content.HeroButtonText;
                        }

                        <a href="@heroButtonUrl"
                           class="home-btn home-btn-primary home-hero-button">

                            <span>
                                @heroButtonText
                            </span>

                            <span class="home-btn-icon">
                                ←
                            </span>

                        </a>

                        <a asp-controller="Archive"
                           asp-action="Index"
                           class="home-btn home-btn-secondary">

                            <span>
                                جستجو در آرشیو
                            </span>

                            <span class="home-btn-icon">
                                ⌕
                            </span>

                        </a>

                    </div>

                    <!-- HERO TRUST -->

                    <div class="home-hero-trust">

                        <span>
                            <span class="home-trust-icon">✓</span>
                            آرشیو صوتی
                        </span>

                        <span>
                            <span class="home-trust-icon">✓</span>
                            دسترسی سریع
                        </span>

                        <span>
                            <span class="home-trust-icon">✓</span>
                            پخش آنلاین
                        </span>

                    </div>

                </div>


                <!-- HERO VISUAL -->

                @if (!string.IsNullOrWhiteSpace(Model.Content.HeroImageUrl))
                {
                    <div class="home-hero-visual">

                        <div class="home-hero-image-decoration"></div>

                        <div class="home-hero-image-wrapper">

                            <img src="@Model.Content.HeroImageUrl"
                                 alt="مجالس اهواز"
                                 class="home-hero-image"
                                 loading="eager" />

                            <div class="home-hero-image-overlay"></div>

                            <div class="home-hero-floating-card">

                                <div class="home-floating-icon">
                                    ▶
                                </div>

                                <div>
                                    <strong>
                                        آرشیو صوتی
                                    </strong>

                                    <span>
                                        همیشه در دسترس شما
                                    </span>
                                </div>

                            </div>

                        </div>

                    </div>
                }
                else
                {
                    <div class="home-hero-visual home-hero-visual-placeholder">

                        <div class="home-hero-pattern"></div>

                        <div class="home-hero-placeholder-content">

                            <div class="home-hero-placeholder-icon">
                                ♪
                            </div>

                            <span>
                                آرشیو صوتی
                            </span>

                            <strong>
                                مجالس اهواز
                            </strong>

                        </div>

                    </div>
                }

            </div>

        </div>

    </section>


    <!-- =====================================================
         STATISTICS
         ===================================================== -->

    <section class="home-stats">

        <div class="container">

            <div class="home-stats-card">

                <div class="home-stat-item">

                    <div class="home-stat-icon">
                        ♪
                    </div>

                    <div class="home-stat-content">

                        <strong>
                            @Model.AudioCount
                        </strong>

                        <span>
                            فایل صوتی
                        </span>

                    </div>

                </div>

                <div class="home-stat-divider"></div>

                <div class="home-stat-item">

                    <div class="home-stat-icon">
                        ◉
                    </div>

                    <div class="home-stat-content">

                        <strong>
                            @Model.SpeakerCount
                        </strong>

                        <span>
                            سخنران
                        </span>

                    </div>

                </div>

                <div class="home-stat-divider"></div>

                <div class="home-stat-item">

                    <div class="home-stat-icon">
                        ◈
                    </div>

                    <div class="home-stat-content">

                        <strong>
                            @Model.CategoryCount
                        </strong>

                        <span>
                            موضوع
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- =====================================================
         INTRODUCTION
         ===================================================== -->

    @if (!string.IsNullOrWhiteSpace(Model.Content.IntroTitle) ||
         !string.IsNullOrWhiteSpace(Model.Content.IntroText))
    {
        <section class="home-intro-section">

            <div class="container">

                <div class="home-intro">

                    <div class="home-intro-mark">
                        <span></span>
                        <span></span>
                        <span></span>
                    </div>

                    <div class="home-intro-content">

                        <span class="home-section-eyebrow">
                            درباره مجالس اهواز
                        </span>

                        @if (!string.IsNullOrWhiteSpace(Model.Content.IntroTitle))
                        {
                            <h2>
                                @Model.Content.IntroTitle
                            </h2>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.Content.IntroText))
                        {
                            <p>
                                @Model.Content.IntroText
                            </p>
                        }

                    </div>

                </div>

            </div>

        </section>
    }


    <!-- =====================================================
         LATEST AUDIOS
         ===================================================== -->

    <section class="home-section home-latest-section"
             id="latest-audios">

        <div class="container">

            <div class="home-section-header">

                <div class="home-section-heading">

                    <span class="home-section-eyebrow">
                        تازه‌ترین محتوا
                    </span>

                    <h2>
                        @if (!string.IsNullOrWhiteSpace(Model.Content.ArchiveTitle))
                        {
                            @Model.Content.ArchiveTitle
                        }
                        else
                        {
                            <text>آخرین سخنرانی‌ها</text>
                        }
                    </h2>

                    @if (!string.IsNullOrWhiteSpace(Model.Content.ArchiveDescription))
                    {
                        <p>
                            @Model.Content.ArchiveDescription
                        </p>
                    }

                </div>

                @{
                    var archiveUrl =
                        string.IsNullOrWhiteSpace(Model.Content.ArchiveButtonUrl)
                            ? Url.Action("Index", "Archive")
                            : Model.Content.ArchiveButtonUrl;

                    var archiveText =
                        string.IsNullOrWhiteSpace(Model.Content.ArchiveButtonText)
                            ? "مشاهده همه"
                            : Model.Content.ArchiveButtonText;
                }

                <a href="@archiveUrl"
                   class="home-section-link">

                    <span>
                        @archiveText
                    </span>

                    <span class="home-link-arrow">
                        ←
                    </span>

                </a>

            </div>


            @if (Model.LatestAudios.Any())
            {
                <div class="home-audio-grid">

                    @foreach (var audio in Model.LatestAudios)
                    {
                        var audioUrl = audio.FileName;

                        <article class="home-audio-card">

                            <!-- AUDIO INFORMATION -->

                            <div class="home-audio-card-header">

                                <div class="home-audio-cover">

                                    @if (!string.IsNullOrWhiteSpace(audio.CoverImageUrl))
                                    {
                                        <img src="@audio.CoverImageUrl"
                                             alt="@audio.Title"
                                             loading="lazy" />
                                    }
                                    else
                                    {
                                        <div class="home-audio-cover-placeholder">
                                            <span>♪</span>
                                        </div>
                                    }

                                </div>

                                <div class="home-audio-info">

                                    @if (audio.Categories.Any())
                                    {
                                        <div class="home-audio-category">

                                            @foreach (var category in audio.Categories.Take(2))
                                            {
                                                <span>
                                                    @category
                                                </span>
                                            }

                                        </div>
                                    }

                                    <h3>

                                        <a asp-controller="Archive"
                                           asp-action="Details"
                                           asp-route-id="@audio.Id">

                                            @audio.Title

                                        </a>

                                    </h3>

                                    @if (!string.IsNullOrWhiteSpace(audio.SpeakerName))
                                    {
                                        <span class="home-audio-speaker">
                                            @audio.SpeakerName
                                        </span>
                                    }

                                </div>

                            </div>


                            <!-- AUDIO META -->

                            <div class="home-audio-meta">

                                @if (audio.PublishedAt.HasValue)
                                {
                                    <span class="home-audio-meta-item">

                                        <span class="home-meta-icon">
                                            ◷
                                        </span>

                                        @audio.PublishedAt.Value.ToLocalTime().ToString("yyyy/MM/dd")

                                    </span>
                                }

                                @if (audio.Duration.HasValue)
                                {
                                    <span class="home-audio-meta-item">

                                        <span class="home-meta-icon">
                                            ◉
                                        </span>

                                        @audio.Duration.Value.ToString(@"mm\:ss")

                                    </span>
                                }

                            </div>


                            <!-- AUDIO PLAYER -->

                            @if (!string.IsNullOrWhiteSpace(audioUrl))
                            {
                                <div class="custom-audio-player"
                                     data-audio-player>

                                    <audio class="audio-player"
                                           preload="metadata"
                                           src="@audioUrl">
                                    </audio>


                                    <!-- PLAYER TOP -->

                                    <div class="player-top">

                                        <div class="player-cover">

                                            @if (!string.IsNullOrWhiteSpace(audio.CoverImageUrl))
                                            {
                                                <img src="@audio.CoverImageUrl"
                                                     alt="@audio.Title"
                                                     loading="lazy" />
                                            }
                                            else
                                            {
                                                <div class="player-cover-placeholder">
                                                    ♪
                                                </div>
                                            }

                                        </div>

                                        <div class="player-info">

                                            <span class="player-label">
                                                پخش صوت
                                            </span>

                                            <span class="player-title">
                                                @audio.Title
                                            </span>

                                        </div>

                                        <button type="button"
                                                class="player-play-button"
                                                aria-label="پخش @audio.Title">

                                            <span class="play-icon">
                                                ▶
                                            </span>

                                            <span class="pause-icon">
                                                ❚❚
                                            </span>

                                        </button>

                                    </div>


                                    <!-- PLAYER PROGRESS -->

                                    <div class="player-progress-area">

                                        <span class="player-time current-time">
                                            00:00
                                        </span>

                                        <div class="player-progress">

                                            <input type="range"
                                                   class="progress-range"
                                                   min="0"
                                                   max="100"
                                                   value="0"
                                                   step="0.1"
                                                   aria-label="موقعیت پخش" />

                                        </div>

                                        <span class="player-time total-time">

                                            @if (audio.Duration.HasValue)
                                            {
                                                @audio.Duration.Value.ToString(@"mm\:ss")
                                            }
                                            else
                                            {
                                                <text>00:00</text>
                                            }

                                        </span>

                                    </div>


                                    <!-- PLAYER BOTTOM -->

                                    <div class="player-bottom">

                                        <div class="player-volume">

                                            <button type="button"
                                                    class="player-control volume-button"
                                                    aria-label="قطع صدا">
                                                🔊
                                            </button>

                                            <input type="range"
                                                   class="volume-range"
                                                   min="0"
                                                   max="1"
                                                   step="0.01"
                                                   value="1"
                                                   aria-label="میزان صدا" />

                                        </div>

                                        <a asp-controller="Archive"
                                           asp-action="Details"
                                           asp-route-id="@audio.Id"
                                           class="player-more">

                                            مشاهده جزئیات

                                            <span>
                                                ←
                                            </span>

                                        </a>

                                    </div>

                                </div>
                            }

                        </article>
                    }

                </div>
            }
            else
            {
                <div class="home-empty">

                    <div class="home-empty-icon">
                        ♪
                    </div>

                    <h3>
                        هنوز سخنرانی‌ای منتشر نشده است
                    </h3>

                    <p>
                        به‌زودی محتوای صوتی جدید در این بخش قرار خواهد گرفت.
                    </p>

                    <a asp-controller="Archive"
                       asp-action="Index"
                       class="home-btn home-btn-primary">

                        مشاهده آرشیو

                    </a>

                </div>
            }

        </div>

    </section>


    <!-- =====================================================
         CATEGORIES
         ===================================================== -->

    <section class="home-section home-categories-section">

        <div class="container">

            <div class="home-section-header">

                <div class="home-section-heading">

                    <span class="home-section-eyebrow">
                        موضوعات
                    </span>

                    <h2>
                        دسته‌بندی‌های آرشیو
                    </h2>

                    <p>
                        محتوای مورد نظر خود را بر اساس موضوع پیدا کنید.
                    </p>

                </div>


                <!-- لینک به صفحه اصلی دسته‌بندی‌ها -->

                <a asp-controller="Categories"
                   asp-action="Index"
                   class="home-section-link">

                    <span>
                        مشاهده همه دسته‌بندی‌ها
                    </span>

                    <span class="home-link-arrow">
                        ←
                    </span>

                </a>

            </div>


            @if (Model.Categories.Any())
            {
                <div class="home-category-grid">

                    @foreach (var category in Model.Categories)
                    {
                        <!-- هر کارت مستقیماً به جزئیات دسته‌بندی می‌رود -->

                        <a asp-controller="Categories"
                           asp-action="Details"
                           asp-route-id="@category.Id"
                           class="home-category-card">

                            <div class="home-category-icon">

                                <span>
                                    ◈
                                </span>

                            </div>


                            <div class="home-category-content">

                                <h3>
                                    @category.Name
                                </h3>

                                <span>
                                    @category.AudioCount فایل صوتی
                                </span>

                            </div>


                            <span class="home-category-arrow">
                                ←
                            </span>

                        </a>
                    }

                </div>
            }
            else
            {
                <div class="home-empty">

                    <div class="home-empty-icon">
                        ◈
                    </div>

                    <h3>
                        دسته‌بندی‌ای وجود ندارد
                    </h3>

                    <p>
                        دسته‌بندی‌های محتوای صوتی به‌زودی در این بخش قرار می‌گیرند.
                    </p>

                    <a asp-controller="Archive"
                       asp-action="Index"
                       class="home-btn home-btn-primary">

                        مشاهده آرشیو

                    </a>

                </div>
            }

        </div>

    </section>


    <!-- =====================================================
         SPEAKERS
         ===================================================== -->

    <section class="home-section home-speakers-section">

        <div class="container">

            <div class="home-section-header">

                <div class="home-section-heading">

                    <span class="home-section-eyebrow">
                        سخنرانان
                    </span>

                    <h2>

                        @if (!string.IsNullOrWhiteSpace(Model.Content.SpeakersTitle))
                        {
                            @Model.Content.SpeakersTitle
                        }
                        else
                        {
                            <text>
                                سخنرانان مجالس
                            </text>
                        }

                    </h2>

                    @if (!string.IsNullOrWhiteSpace(Model.Content.SpeakersDescription))
                    {
                        <p>
                            @Model.Content.SpeakersDescription
                        </p>
                    }

                </div>


                <!-- لینک به صفحه سخنرانان -->

                <a asp-controller="Speakers"
                   asp-action="Index"
                   class="home-section-link">

                    <span>
                        مشاهده همه سخنرانان
                    </span>

                    <span class="home-link-arrow">
                        ←
                    </span>

                </a>

            </div>


            @if (Model.Speakers.Any())
            {
                <div class="home-speaker-grid">

                    @foreach (var speaker in Model.Speakers)
                    {
                        <!-- کارت سخنران → صفحه جزئیات سخنران -->

                        <a asp-controller="Speakers"
                           asp-action="Details"
                           asp-route-id="@speaker.Id"
                           class="home-speaker-card">

                            <div class="home-speaker-image">

                                @if (!string.IsNullOrWhiteSpace(speaker.ImageUrl))
                                {
                                    <img src="@speaker.ImageUrl"
                                         alt="@speaker.Name"
                                         loading="lazy" />
                                }
                                else
                                {
                                    <div class="home-speaker-placeholder">

                                        <span>
                                            ◉
                                        </span>

                                    </div>
                                }

                            </div>


                            <div class="home-speaker-info">

                                <h3>
                                    @speaker.Name
                                </h3>

                                <span>
                                    @speaker.AudioCount سخنرانی
                                </span>

                            </div>


                            <span class="home-speaker-arrow">
                                ←
                            </span>

                        </a>
                    }

                </div>
            }
            else
            {
                <div class="home-empty">

                    <div class="home-empty-icon">
                        ◉
                    </div>

                    <h3>
                        هنوز سخنرانی ثبت نشده است
                    </h3>

                </div>
            }

        </div>

    </section>


    <!-- =====================================================
         SOCIAL NETWORKS
         ===================================================== -->

    <section class="home-section home-social-section">

        <div class="container">

            <div class="home-social">

                <div class="home-social-heading">

                    <span class="home-section-eyebrow">
                        ارتباط با ما
                    </span>

                    <h2>
                        مجالس اهواز را دنبال کنید
                    </h2>

                    <p>
                        برای دریافت اطلاعیه‌ها، جلسات جدید و تازه‌ترین
                        محتوای صوتی، ما را در شبکه‌های اجتماعی دنبال کنید.
                    </p>

                </div>


                <div class="home-social-grid">

                    <!-- بله -->

                    <a href="https://ble.ir/ahvazmajlesbot"
                       class="home-social-card home-social-bale"
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="مجالس اهواز در بله">

                        <div class="home-social-icon">
                            <span>ب</span>
                        </div>

                        <div class="home-social-info">

                            <strong>
                                بله
                            </strong>

                            <span>
                                ربات مجالس اهواز
                            </span>

                        </div>

                        <span class="home-social-arrow">
                            ←
                        </span>

                    </a>


                    <!-- ایتا -->

                    <a href="https://eitaa.com/ahvazmajles"
                       class="home-social-card home-social-eitaa"
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="مجالس اهواز در ایتا">

                        <div class="home-social-icon">
                            <span>ا</span>
                        </div>

                        <div class="home-social-info">

                            <strong>
                                ایتا
                            </strong>

                            <span>
                                کانال مجالس اهواز
                            </span>

                        </div>

                        <span class="home-social-arrow">
                            ←
                        </span>

                    </a>


                    <!-- تلگرام -->

                    <a href="https://t.me/ahvazmajlesbot"
                       class="home-social-card home-social-telegram"
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="مجالس اهواز در تلگرام">

                        <div class="home-social-icon">
                            <span>✈</span>
                        </div>

                        <div class="home-social-info">

                            <strong>
                                تلگرام
                            </strong>

                            <span>
                                ربات مجالس اهواز
                            </span>

                        </div>

                        <span class="home-social-arrow">
                            ←
                        </span>

                    </a>

                </div>

            </div>

        </div>

    </section>


    <!-- =====================================================
         FINAL CTA
         ===================================================== -->

    <section class="home-cta">

        <div class="home-cta-pattern"></div>

        <div class="container">

            <div class="home-cta-content">

                <div class="home-cta-icon">
                    ♪
                </div>

                <span class="home-cta-eyebrow">
                    آرشیو صوتی مجالس اهواز
                </span>

                <h2>
                    صدای علم و معارف، همیشه در دسترس شما
                </h2>

                <p>
                    در آرشیو صوتی جستجو کنید و سخنرانی مورد نظر خود را
                    سریع و آسان پیدا کنید.
                </p>

                <a asp-controller="Archive"
                   asp-action="Index"
                   class="home-btn home-btn-primary home-cta-button">

                    <span>
                        ورود به آرشیو
                    </span>

                    <span class="home-btn-icon">
                        ←
                    </span>

                </a>

            </div>

        </div>

    </section>

</main>


@section Scripts {

    <script src="~/js/archive-player.js"
            asp-append-version="true"></script>

}