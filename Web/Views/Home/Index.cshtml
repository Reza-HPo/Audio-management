@{
    ViewData["Title"] = "خانه";
}

<!-- =========================================================
     HERO
========================================================= -->

<section class="home-hero">

    <div class="container">

        <div class="row align-items-center g-5">

            <!-- Hero Content -->

            <div class="col-lg-7">

                <div class="home-hero-content">

                    <span class="home-hero-eyebrow">
                        آرشیو صوتی مکتب اهواز
                    </span>

                    <h1 class="home-hero-title">

                        جایی برای
                        <span>شنیدن</span>
                        و یادگیری

                    </h1>

                    <p class="home-hero-description">

                        مجموعه‌ای از سخنرانی‌ها، معارف اسلامی و
                        محتوای صوتی که با هدف دسترسی آسان‌تر،
                        در یک آرشیو منظم و کاربردی گردآوری شده است.

                    </p>


                    <div class="home-hero-actions">

                        <a asp-controller="Archive"
                           asp-action="Index"
                           class="home-btn home-btn-primary">

                            <span>
                                مشاهده آرشیو
                            </span>

                            <span class="home-btn-arrow">
                                ←
                            </span>

                        </a>


                        <a href="#categories"
                           class="home-btn home-btn-secondary">

                            دسته‌بندی‌ها

                        </a>

                    </div>


                    <!-- Hero Stats -->

                    <div class="home-hero-stats">

                        <div class="hero-stat">

                            <strong>
                                +۱۰۰
                            </strong>

                            <span>
                                فایل صوتی
                            </span>

                        </div>


                        <div class="hero-stat-divider"></div>


                        <div class="hero-stat">

                            <strong>
                                +۲۰
                            </strong>

                            <span>
                                سخنران
                            </span>

                        </div>


                        <div class="hero-stat-divider"></div>


                        <div class="hero-stat">

                            <strong>
                                رایگان
                            </strong>

                            <span>
                                دسترسی به محتوا
                            </span>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Hero Visual -->

            <div class="col-lg-5">

                <div class="home-hero-visual">

                    <div class="hero-decoration hero-decoration-one"></div>

                    <div class="hero-decoration hero-decoration-two"></div>


                    <div class="hero-main-card">

                        <div class="hero-card-header">

                            <div class="hero-card-icon">
                                ♪
                            </div>

                            <div>

                                <span>
                                    آرشیو صوتی
                                </span>

                                <strong>
                                    مکتب اهواز
                                </strong>

                            </div>

                        </div>


                        <div class="hero-wave">

                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>

                        </div>


                        <div class="hero-card-footer">

                            <span>
                                برای شنیدن آماده است
                            </span>

                            <div class="hero-card-play">
                                ▶
                            </div>

                        </div>

                    </div>


                    <div class="hero-floating-card">

                        <div class="floating-icon">
                            ✓
                        </div>

                        <div>

                            <strong>
                                دسترسی آسان
                            </strong>

                            <span>
                                محتوای مورد علاقه‌تان را پیدا کنید
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>



