@{
    ViewData["Title"] = "خانه";
}

<section class="hero-section">

    <div class="container">

        <div class="row align-items-center g-5">

            <div class="col-lg-7">

                <span class="hero-badge">
                    آرشیو صوتی مکتب اهواز
                </span>

                <h1 class="hero-title">

                    جایی برای
                    <span>شنیدن</span>
                    و یادگیری

                </h1>

                <p class="hero-description">

                    مجموعه‌ای از سخنرانی‌ها و محتوای صوتی
                    که برای دسترسی آسان‌تر، در یک آرشیو
                    منظم و کاربردی گردآوری شده است.

                </p>

                <div class="hero-actions">

                    <a href="#audio"
                       class="btn btn-primary hero-primary-button">

                        مشاهده آرشیو صوتی

                    </a>

                    <a href="#categories"
                       class="btn hero-secondary-button">

                        مرور دسته‌بندی‌ها

                    </a>

                </div>

            </div>


            <div class="col-lg-5">

                <div class="hero-visual">

                    <div class="hero-circle hero-circle-one"></div>

                    <div class="hero-circle hero-circle-two"></div>

                    <div class="hero-audio-card">

                        <div class="hero-audio-icon">
                            ♪
                        </div>

                        <div class="hero-audio-content">

                            <span>
                                محتوای صوتی
                            </span>

                            <strong>
                                برای شنیدن آماده است
                            </strong>

                        </div>

                        <button type="button"
                                class="hero-play-button">

                            ▶

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

<section class="audio-section" id="audio">

