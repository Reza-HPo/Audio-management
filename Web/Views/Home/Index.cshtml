@model Web.Models.ViewModels.Home.HomeViewModel

@{
    ViewData["Title"] = "خانه";

}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" />
}

<!-- =========================================================
     HERO
========================================================= -->

<section class="home-hero">

    <div class="container">

        <div class="row align-items-center g-5">

            <!-- Hero Content -->

            <div class="col-lg-7">

                <div class="home-hero-content">

                    <span class="home-hero-eyebrow">
                        آرشیو صوتی مکتب وحی رفقای اهواز
                    </span>

                    <h1 class="home-hero-title">

                        جایی برای
                        <span>شنیدن</span>
                        و یادگیری

                    </h1>

                    <p class="home-hero-description">

                        مجموعه‌ای از سخنرانی‌ها، معارف اسلامی و
                        محتوای صوتی که با هدف دسترسی آسان‌تر،
                        در یک آرشیو منظم و کاربردی گردآوری شده است.

                    </p>


                    <div class="home-hero-actions">

                        <a asp-controller="Archive"
                           asp-action="Index"
                           class="home-btn home-btn-primary">

                            <span>
                                مشاهده آرشیو
                            </span>

                            <span class="home-btn-arrow">
                                ←
                            </span>

                        </a>


                        <a href="#categories"
                           class="home-btn home-btn-secondary">

                            دسته‌بندی‌ها

                        </a>

                    </div>


                    <!-- Hero Stats -->

                    <div class="home-hero-stats">

                        <div class="hero-stat">

                            <strong>
                                @Model.AudioCount
                            </strong>

                            <span>
                                فایل صوتی
                            </span>

                        </div>


                        <div class="hero-stat-divider"></div>


                        <div class="hero-stat">

                            <strong>
                                @Model.SpeakerCount
                            </strong>

                            <span>
                                سخنران
                            </span>

                        </div>


                        <div class="hero-stat-divider"></div>


                        <div class="hero-stat">

                            <strong>
                                رایگان
                            </strong>

                            <span>
                                دسترسی به محتوا
                            </span>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Hero Visual -->

            <div class="col-lg-5">

                <div class="home-hero-visual">

                    <div class="hero-decoration hero-decoration-one"></div>

                    <div class="hero-decoration hero-decoration-two"></div>


                    <div class="hero-main-card">

                        <div class="hero-card-header">

                            <div class="hero-card-icon">
                                ♪
                            </div>

                            <div>

                                <span>
                                    آرشیو صوتی
                                </span>

                                <strong>
                                    مکتب اهواز
                                </strong>

                            </div>

                        </div>


                        <div class="hero-wave">

                            @for (var i = 0; i < 20; i++)
                            {
                                <span></span>
                            }

                        </div>


                        <div class="hero-card-footer">

                            <span>
                                برای شنیدن آماده است
                            </span>

                            <div class="hero-card-play">
                                ▶
                            </div>

                        </div>

                    </div>


                    <div class="hero-floating-card">

                        <div class="floating-icon">
                            ✓
                        </div>

                        <div>

                            <strong>
                                دسترسی آسان
                            </strong>

                            <span>
                                محتوای مورد علاقه‌تان را پیدا کنید
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>



<!-- =========================================================
     LATEST AUDIO
========================================================= -->

<section class="home-audio-section">

    <div class="container">

        <div class="home-section-heading">

            <div>

                <span class="home-section-eyebrow">
                    آرشیو صوتی
                </span>

                <h2>
                    آخرین سخنرانی‌ها
                </h2>

                <p>
                    جدیدترین محتوای صوتی اضافه‌شده به آرشیو
                </p>

            </div>


            <a asp-controller="Archive"
               asp-action="Index"
               class="home-section-more">

                مشاهده همه

                <span>
                    ←
                </span>

            </a>

        </div>


        <div class="row g-4">

            @if (Model.LatestAudios.Any())
            {
                foreach (var audio in Model.LatestAudios)
                {
                    <div class="col-md-6 col-xl-4">

                        <article class="home-audio-card">

                            <div class="home-audio-card-top">

                                <div class="home-audio-cover">

                                    @if (!string.IsNullOrWhiteSpace(audio.CoverImageUrl))
                                    {
                                        <img src="@audio.CoverImageUrl"
                                             alt="@audio.Title" />
                                    }
                                    else
                                    {
                                        <span>
                                            ♪
                                        </span>
                                    }

                                </div>


                                <div class="home-audio-info">

                                    @if (audio.Categories.Any())
                                    {
                                        <span class="home-audio-category">

                                            @audio.Categories.First()

                                        </span>
                                    }

                                    <h3>
                                        @audio.Title
                                    </h3>

                                    @if (!string.IsNullOrWhiteSpace(audio.SpeakerName))
                                    {
                                        <p>
                                            @audio.SpeakerName
                                        </p>
                                    }

                                </div>

                            </div>


                            <div class="home-audio-meta">

                                @if (audio.Duration.HasValue)
                                {
                                    <span>
                                        🎧
                                        @audio.Duration.Value.ToString(@"hh\:mm\:ss")
                                    </span>
                                }

                                @if (audio.PublishedAt.HasValue)
                                {
                                    <span>
                                        @audio.PublishedAt.Value.ToLocalTime().ToString("yyyy/MM/dd")
                                    </span>
                                }

                            </div>


                            <div class="home-audio-player">

                                <button type="button"
                                        class="home-audio-play"
                                        aria-label="پخش">

                                    ▶

                                </button>


                                <div class="home-audio-progress">

                                    <div class="home-audio-progress-fill"></div>

                                </div>


                                @if (audio.Duration.HasValue)
                                {
                                    <span class="home-audio-duration">
                                        @audio.Duration.Value.ToString(@"mm\:ss")
                                    </span>
                                }


                                @if (!string.IsNullOrWhiteSpace(audio.FileName))
                                {
                                    <audio preload="metadata"
                                           class="home-audio-element"
                                           src="@audio.FileName">
                                    </audio>
                                }

                            </div>

                        </article>

                    </div>
                }
            }
            else
            {
                <div class="col-12">

                    <div class="archive-empty">

                        <div class="archive-empty-icon">
                            ♪
                        </div>

                        <h3>
                            هنوز فایل صوتی‌ای ثبت نشده است
                        </h3>

                        <p>
                            به محض اضافه شدن فایل‌های صوتی،
                            جدیدترین محتوا در این بخش نمایش داده می‌شود.
                        </p>

                    </div>

                </div>
            }

        </div>

    </div>

</section>



<!-- =========================================================
     CATEGORIES
========================================================= -->

<section class="home-categories-section"
         id="categories">

    <div class="container">

        <div class="home-section-heading">

            <div>

                <span class="home-section-eyebrow">
                    کشف محتوا
                </span>

                <h2>
                    موضوع مورد علاقه‌تان را پیدا کنید
                </h2>

                <p>
                    محتوای آرشیو را بر اساس موضوع مرور کنید
                </p>

            </div>


            <a asp-controller="Archive"
               asp-action="Index"
               class="home-section-more">

                همه دسته‌بندی‌ها

                <span>
                    ←
                </span>

            </a>

        </div>


        <div class="row g-3">

            @if (Model.Categories.Any())
            {
                var categoryIndex = 1;

                foreach (var category in Model.Categories)
                {
                    <div class="col-6 col-md-4 col-lg-3">

                        <a asp-controller="Archive"
                           asp-action="Index"
                           asp-route-categoryId="@category.Id"
                           class="home-category-card">

                            <div class="home-category-icon">

                                <span>
                                    @categoryIndex.ToString("00")
                                </span>

                            </div>


                            <div class="home-category-content">

                                <h3>
                                    @category.Name
                                </h3>

                                <span>
                                    @category.AudioCount فایل
                                </span>

                            </div>


                            <span class="home-category-arrow">
                                ←
                            </span>

                        </a>

                    </div>

                    categoryIndex++;
                }
            }
            else
            {
                <div class="col-12">

                    <p>
                        هنوز دسته‌بندی‌ای ثبت نشده است.
                    </p>

                </div>
            }

        </div>

    </div>

</section>



<!-- =========================================================
     SPEAKERS
========================================================= -->

<section class="home-speakers-section"
         id="speakers">

    <div class="container">

        <div class="home-section-heading">

            <div>

                <span class="home-section-eyebrow">
                    سخنران‌ها
                </span>

                <h2>
                    سخنران‌های منتخب
                </h2>

                <p>
                    سخنران مورد نظر خود را پیدا کنید و محتوای او را بشنوید
                </p>

            </div>


            <a asp-controller="Archive"
               asp-action="Index"
               class="home-section-more">

                همه سخنران‌ها

                <span>
                    ←
                </span>

            </a>

        </div>


        <div class="row g-3">

            @if (Model.Speakers.Any())
            {
                foreach (var speaker in Model.Speakers)
                {
                    <div class="col-6 col-lg-3">

                        <a asp-controller="Archive"
                           asp-action="Index"
                           asp-route-speakerId="@speaker.Id"
                           class="home-speaker-card">


                            <div class="home-speaker-avatar">

                                @if (!string.IsNullOrWhiteSpace(speaker.ImageUrl))
                                {
                                    <img src="@speaker.ImageUrl"
                                         alt="@speaker.Name" />
                                }
                                else
                                {
                                    @speaker.Name.FirstOrDefault()
                                }

                            </div>


                            <div class="home-speaker-info">

                                <h3>
                                    @speaker.Name
                                </h3>

                                <span>
                                    @speaker.AudioCount سخنرانی
                                </span>

                            </div>


                            <span class="home-speaker-arrow">
                                ←
                            </span>

                        </a>

                    </div>
                }
            }
            else
            {
                <div class="col-12">

                    <p>
                        هنوز سخنرانی ثبت نشده است.
                    </p>

                </div>
            }

        </div>

    </div>

</section>



<!-- =========================================================
     CTA
========================================================= -->

<section class="home-cta-section">

    <div class="container">

        <div class="home-cta">

            <div class="home-cta-content">

                <span>
                    مکتب اهواز
                </span>

                <h2>
                    چیزی برای شنیدن پیدا کن
                </h2>

                <p>
                    در میان مجموعه‌ای از سخنرانی‌ها و محتوای صوتی
                    جست‌وجو کن و آنچه را می‌خواهی بشنو.
                </p>

            </div>


            <a asp-controller="Archive"
               asp-action="Index"
               class="home-cta-button">

                ورود به آرشیو

                <span>
                    ←
                </span>

            </a>

        </div>

    </div>

</section>



@section Scripts {

    <script>

        document
            .querySelectorAll(".home-audio-card")
            .forEach(function (card) {

                const button =
                    card.querySelector(".home-audio-play");

                const audio =
                    card.querySelector(".home-audio-element");

                const progress =
                    card.querySelector(".home-audio-progress-fill");


                if (!button || !audio)
                    return;


                button.addEventListener("click", function () {

                    // Stop other audios

                    document
                        .querySelectorAll(".home-audio-element")
                        .forEach(function (otherAudio) {

                            if (otherAudio !== audio) {

                                otherAudio.pause();

                                const otherCard =
                                    otherAudio.closest(".home-audio-card");

                                if (otherCard) {

                                    const otherButton =
                                        otherCard.querySelector(".home-audio-play");

                                    if (otherButton) {
                                        otherButton.textContent = "▶";
                                    }

                                }

                            }

                        });


                    if (audio.paused) {

                        audio.play();

                        button.textContent = "❚❚";

                    }
                    else {

                        audio.pause();

                        button.textContent = "▶";

                    }

                });


                audio.addEventListener("timeupdate", function () {

                    if (!audio.duration)
                        return;

                    const percentage =
                        (audio.currentTime / audio.duration) * 100;

                    if (progress) {

                        progress.style.width =
                            percentage + "%";

                    }

                });


                audio.addEventListener("ended", function () {

                    button.textContent = "▶";

                    if (progress) {
                        progress.style.width = "0%";
                    }

                });

            });

    </script>

}