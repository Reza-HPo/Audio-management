@model Web.Models.ViewModels.Archive.AudioItemViewModel

@{
    ViewData["Title"] = Model.Title;

    // فایل صوتی اکنون روی هاست دانلود قرار دارد
    // و FileName شامل URL کامل فایل است.
    var audioUrl = Model.FileName;

    string durationText = "00:00";

    if (Model.Duration.HasValue)
    {
        durationText =
            Model.Duration.Value.ToString(@"hh\:mm\:ss");
    }
}

@section Styles {

    <link rel="stylesheet"
          href="~/css/audio-details.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/player.css"
          asp-append-version="true" />
}


<section class="audio-details-page">

    <div class="container">

        <!-- =====================================================
             BACK
        ====================================================== -->

        <div class="audio-details-back">

            <a asp-controller="Archive"
               asp-action="Index"
               class="audio-back-link">

                <span class="back-icon"
                      aria-hidden="true">
                    →
                </span>

                <span>
                    بازگشت به آرشیو
                </span>

            </a>

        </div>


        <!-- =====================================================
             MAIN CARD
        ====================================================== -->

        <article class="audio-details-card">


            <!-- =================================================
                 COVER
            ================================================== -->

            <div class="audio-details-cover">

                @if (!string.IsNullOrWhiteSpace(Model.CoverImageUrl))
                {
                    <img src="@Model.CoverImageUrl"
                         alt="@Model.Title"
                         loading="eager" />
                }
                else
                {
                    <div class="audio-details-cover-placeholder"
                         aria-hidden="true">

                        <span>♪</span>

                    </div>
                }

            </div>


            <!-- =================================================
                 CONTENT
            ================================================== -->

            <div class="audio-details-content">


                <!-- =================================================
                     CATEGORIES
                ================================================== -->

                @if (Model.Categories != null &&
                     Model.Categories.Any())
                {
                    <div class="audio-details-categories">

                        @foreach (var category in Model.Categories)
                        {
                            <span class="audio-category">
                                @category
                            </span>
                        }

                    </div>
                }


                <!-- =================================================
                     TITLE
                ================================================== -->

                <h1 class="audio-details-title">
                    @Model.Title
                </h1>


                <!-- =================================================
                     SPEAKER
                ================================================== -->

                @if (!string.IsNullOrWhiteSpace(Model.SpeakerName))
                {
                    <div class="audio-details-speaker">

                        <span class="speaker-label">
                            سخنران
                        </span>

                        <span class="speaker-divider"
                              aria-hidden="true">
                            •
                        </span>

                        <span class="speaker-name">
                            @Model.SpeakerName
                        </span>

                    </div>
                }


                <!-- =================================================
                     META
                ================================================== -->

                <div class="audio-details-meta">

                    @if (Model.PublishedAt.HasValue)
                    {
                        <span class="audio-meta-item">

                            <span class="meta-icon"
                                  aria-hidden="true">
                                📅
                            </span>

                            <span>
                                @Model.PublishedAt.Value.ToLocalTime().ToString("yyyy/MM/dd")
                            </span>

                        </span>
                    }


                    <span class="audio-meta-item">

                        <span class="meta-icon"
                              aria-hidden="true">
                            ◷
                        </span>

                        <span id="metaDuration">
                            @durationText
                        </span>

                    </span>


                    <span class="audio-meta-item">

                        <span class="meta-icon"
                              aria-hidden="true">
                            🎧
                        </span>

                        <span>
                            فایل صوتی
                        </span>

                    </span>

                </div>


                <!-- =================================================
                     DESCRIPTION
                ================================================== -->

                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <div class="audio-details-description">

                        <h2>
                            درباره این سخنرانی
                        </h2>

                        <p>
                            @Model.Description
                        </p>

                    </div>
                }


                <!-- =================================================
                     AUDIO PLAYER
                ================================================== -->

                @if (!string.IsNullOrWhiteSpace(audioUrl))
                {
                    <div class="audio-player-section">

                        <!-- PLAYER HEADING -->

                        <div class="audio-player-heading">

                            <div>

                                <span class="audio-player-eyebrow">
                                    پخش آنلاین
                                </span>

                                <h2>
                                    شنیدن فایل صوتی
                                </h2>

                            </div>

                        </div>


                        <!-- =================================================
                             CUSTOM PLAYER
                        ================================================== -->

                        <div class="custom-audio-player"
                             data-audio-player>


                            <!-- =================================================
                                 NATIVE AUDIO
                            ================================================== -->

                            <audio id="audioElement"
                                   class="audio-player"
                                   preload="metadata"
                                   playsinline>

                                <source src="@audioUrl"
                                        type="audio/mpeg" />

                                مرورگر شما از پخش فایل صوتی
                                پشتیبانی نمی‌کند.

                            </audio>


                            <!-- =================================================
                                 PLAYER TOP
                            ================================================== -->

                            <div class="player-top">


                                <!-- PLAYER COVER -->

                                <div class="player-cover">

                                    @if (!string.IsNullOrWhiteSpace(Model.CoverImageUrl))
                                    {
                                        <img src="@Model.CoverImageUrl"
                                             alt="@Model.Title"
                                             loading="lazy" />
                                    }
                                    else
                                    {
                                        <div class="player-cover-placeholder"
                                             aria-hidden="true">
                                            ♪
                                        </div>
                                    }

                                </div>


                                <!-- PLAYER INFO -->

                                <div class="player-info">

                                    <span class="player-label">
                                        آماده پخش
                                    </span>

                                    <strong class="player-title">
                                        @Model.Title
                                    </strong>

                                </div>


                                <!-- PLAY BUTTON -->

                                <button type="button"
                                        class="player-play-button"
                                        id="playButton"
                                        aria-label="پخش">

                                    <span class="play-icon"
                                          aria-hidden="true">
                                        ▶
                                    </span>

                                    <span class="pause-icon"
                                          aria-hidden="true">
                                        ❚❚
                                    </span>

                                </button>

                            </div>


                            <!-- =================================================
                                 PROGRESS
                            ================================================== -->

                            <div class="player-progress-area">

                                <span class="player-time"
                                      id="currentTime">
                                    00:00
                                </span>


                                <div class="player-progress">

                                    <input type="range"
                                           id="progressBar"
                                           class="progress-range"
                                           min="0"
                                           max="100"
                                           value="0"
                                           step="0.1"
                                           aria-label="موقعیت پخش" />

                                </div>


                                <span class="player-time"
                                      id="duration">
                                    @durationText
                                </span>

                            </div>


                            <!-- =================================================
                                 BOTTOM CONTROLS
                            ================================================== -->

                            <div class="player-bottom">


                                <!-- VOLUME -->

                                <div class="player-volume">

                                    <button type="button"
                                            id="volumeButton"
                                            class="player-control"
                                            aria-label="قطع صدا">

                                        🔊

                                    </button>


                                    <input type="range"
                                           id="volumeBar"
                                           class="volume-range"
                                           min="0"
                                           max="1"
                                           value="1"
                                           step="0.05"
                                           aria-label="میزان صدا" />

                                </div>


                                <!-- DOWNLOAD -->

                                @if (Model.IsDownloadable)
                                {
                                    <a href="@audioUrl"
                                       download
                                       class="player-download"
                                       aria-label="دانلود @Model.Title">

                                        <span aria-hidden="true">
                                            ↓
                                        </span>

                                        دانلود فایل

                                    </a>
                                }

                            </div>

                        </div>

                    </div>
                }


            </div>

        </article>

    </div>

</section>


@section Scripts {

<script>

document.addEventListener("DOMContentLoaded", function () {

    /* =========================================================
       ELEMENTS
    ========================================================= */

    const player =
        document.querySelector("[data-audio-player]");

    if (!player) {
        return;
    }


    const audio =
        document.getElementById("audioElement");

    const playButton =
        document.getElementById("playButton");

    const progressBar =
        document.getElementById("progressBar");

    const volumeBar =
        document.getElementById("volumeBar");

    const volumeButton =
        document.getElementById("volumeButton");

    const currentTimeElement =
        document.getElementById("currentTime");

    const durationElement =
        document.getElementById("duration");

    const metaDurationElement =
        document.getElementById("metaDuration");


    if (!audio ||
        !playButton ||
        !progressBar ||
        !volumeBar ||
        !volumeButton ||
        !currentTimeElement ||
        !durationElement) {

        return;
    }


    /* =========================================================
       AUDIO ERROR
    ========================================================= */

    audio.addEventListener("error", function () {

        console.error(
            "Audio loading error:",
            audio.error
        );

        player.classList.add("audio-error");

    });


    /* =========================================================
       FORMAT TIME
    ========================================================= */

    function formatTime(seconds) {

        if (!isFinite(seconds) ||
            seconds < 0) {

            return "00:00";
        }


        const hours =
            Math.floor(seconds / 3600);

        const minutes =
            Math.floor((seconds % 3600) / 60);

        const remainingSeconds =
            Math.floor(seconds % 60);


        if (hours > 0) {

            return String(hours).padStart(2, "0")
                + ":"
                + String(minutes).padStart(2, "0")
                + ":"
                + String(remainingSeconds).padStart(2, "0");
        }


        return String(minutes).padStart(2, "0")
            + ":"
            + String(remainingSeconds).padStart(2, "0");
    }


    /* =========================================================
       PLAY / PAUSE
    ========================================================= */

    playButton.addEventListener(
        "click",
        async function () {

            try {

                if (audio.paused) {

                    await audio.play();

                } else {

                    audio.pause();

                }

            }
            catch (error) {

                console.error(
                    "Audio playback error:",
                    error
                );

            }

        }
    );


    /* =========================================================
       PLAY
    ========================================================= */

    audio.addEventListener(
        "play",
        function () {

            player.classList.add("is-playing");

            playButton.setAttribute(
                "aria-label",
                "توقف"
            );

        }
    );


    /* =========================================================
       PAUSE
    ========================================================= */

    audio.addEventListener(
        "pause",
        function () {

            player.classList.remove(
                "is-playing"
            );

            playButton.setAttribute(
                "aria-label",
                "پخش"
            );

        }
    );


    /* =========================================================
       LOADED METADATA
    ========================================================= */

    audio.addEventListener(
        "loadedmetadata",
        function () {

            if (!isFinite(audio.duration)) {
                return;
            }


            const formattedDuration =
                formatTime(audio.duration);


            durationElement.textContent =
                formattedDuration;


            if (metaDurationElement) {

                metaDurationElement.textContent =
                    formattedDuration;

            }

        }
    );


    /* =========================================================
       PROGRESS
    ========================================================= */

    audio.addEventListener(
        "timeupdate",
        function () {

            if (!isFinite(audio.duration) ||
                audio.duration <= 0) {

                return;
            }


            const percentage =
                (audio.currentTime /
                    audio.duration) * 100;


            progressBar.value =
                percentage;


            currentTimeElement.textContent =
                formatTime(
                    audio.currentTime
                );

        }
    );


    /* =========================================================
       SEEK
    ========================================================= */

    progressBar.addEventListener(
        "input",
        function () {

            if (!isFinite(audio.duration) ||
                audio.duration <= 0) {

                return;
            }


            audio.currentTime =
                (Number(progressBar.value) / 100)
                * audio.duration;

        }
    );


    /* =========================================================
       VOLUME
    ========================================================= */

    volumeBar.addEventListener(
        "input",
        function () {

            const volume =
                Number(volumeBar.value);


            audio.volume =
                volume;


            audio.muted =
                volume === 0;


            updateVolumeIcon();

        }
    );


    /* =========================================================
       MUTE
    ========================================================= */

    volumeButton.addEventListener(
        "click",
        function () {

            audio.muted =
                !audio.muted;


            updateVolumeIcon();

        }
    );


    /* =========================================================
       VOLUME ICON
    ========================================================= */

    function updateVolumeIcon() {

        if (audio.muted ||
            audio.volume === 0) {

            volumeButton.textContent =
                "🔇";


            volumeButton.setAttribute(
                "aria-label",
                "فعال کردن صدا"
            );

            return;
        }


        if (audio.volume < 0.5) {

            volumeButton.textContent =
                "🔉";

        }
        else {

            volumeButton.textContent =
                "🔊";

        }


        volumeButton.setAttribute(
            "aria-label",
            "قطع صدا"
        );

    }


    /* =========================================================
       ENDED
    ========================================================= */

    audio.addEventListener(
        "ended",
        function () {

            player.classList.remove(
                "is-playing"
            );


            progressBar.value =
                0;


            currentTimeElement.textContent =
                "00:00";


            playButton.setAttribute(
                "aria-label",
                "پخش"
            );

        }
    );


    /* =========================================================
       CAN PLAY
    ========================================================= */

    audio.addEventListener(
        "canplay",
        function () {

            player.classList.remove(
                "audio-error"
            );

        }
    );


    /* =========================================================
       INITIAL STATE
    ========================================================= */

    audio.volume =
        1;


    volumeBar.value =
        1;


    updateVolumeIcon();

});

</script>

}