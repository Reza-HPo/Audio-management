@model Web.Models.ViewModels.Archive.ArchiveViewModel

@{
    ViewData["Title"] = "آرشیو صوتی";
}

@section Styles {
    <link rel="stylesheet" href="~/css/archive.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/player.css" asp-append-version="true" />
}

<section class="archive-page">

    <div class="container">

        <!-- =====================================================
             PAGE HEADER
             ===================================================== -->

        <header class="archive-header">

            <span class="section-eyebrow">
                آرشیو مکتب اهواز
            </span>

            <h1>
                آرشیو صوتی
            </h1>

            <p>
                سخنرانی‌ها و محتوای صوتی مورد نظر خود را پیدا کنید.
            </p>

        </header>


        <!-- =====================================================
             SEARCH
             ===================================================== -->

        <div class="archive-search">

            <form asp-controller="Archive"
                  asp-action="Index"
                  method="get">

                <div class="archive-search-box">

                    <span class="archive-search-icon"
                          aria-hidden="true">
                        ⌕
                    </span>

                    <input type="search"
                           name="search"
                           value="@Model.Search"
                           placeholder="جستجو در سخنرانی‌ها..."
                           autocomplete="off"
                           aria-label="جستجو در آرشیو صوتی" />

                    <button type="submit">
                        جستجو
                    </button>

                </div>

            </form>

        </div>


        <!-- =====================================================
             FILTERS
             ===================================================== -->

        <form asp-controller="Archive"
              asp-action="Index"
              method="get"
              class="archive-filter-form">

            <input type="hidden"
                   name="search"
                   value="@Model.Search" />

            <div class="archive-filters">


                <!-- Category -->

                <div class="filter-group">

                    <label for="categoryId">
                        دسته‌بندی
                    </label>

                    <select id="categoryId"
                            name="categoryId"
                            onchange="this.form.submit()">

                        <option value="">
                            همه دسته‌بندی‌ها
                        </option>

                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category.Id"
                                    selected="@(Model.CategoryId == category.Id)">
                                @category.Name
                            </option>
                        }

                    </select>

                </div>


                <!-- Speaker -->

                <div class="filter-group">

                    <label for="speakerId">
                        سخنران
                    </label>

                    <select id="speakerId"
                            name="speakerId"
                            onchange="this.form.submit()">

                        <option value="">
                            همه سخنران‌ها
                        </option>

                        @foreach (var speaker in Model.Speakers)
                        {
                            <option value="@speaker.Id"
                                    selected="@(Model.SpeakerId == speaker.Id)">
                                @speaker.Name
                            </option>
                        }

                    </select>

                </div>


                <!-- Sort -->

                <div class="filter-group">

                    <label for="sort">
                        مرتب‌سازی
                    </label>

                    <select id="sort"
                            name="sort"
                            onchange="this.form.submit()">

                        <option value="newest"
                                selected="@(Model.Sort == "newest")">
                            جدیدترین
                        </option>

                        <option value="oldest"
                                selected="@(Model.Sort == "oldest")">
                            قدیمی‌ترین
                        </option>

                        <option value="alphabetical"
                                selected="@(Model.Sort == "alphabetical")">
                            الفبایی
                        </option>

                    </select>

                </div>

            </div>

        </form>


        <!-- =====================================================
             RESULTS HEADER
             ===================================================== -->

        <div class="archive-results-header">

            <span>
                @Model.TotalCount فایل صوتی
            </span>

        </div>


        <!-- =====================================================
             AUDIO GRID
             ===================================================== -->

        <div class="row g-4">

            @if (Model.Audios.Any())
            {
                foreach (var audio in Model.Audios)
                {
                    <div class="col-md-6 col-xl-4">

                        <article class="audio-card"
                                 data-audio-id="@audio.Id">


                            <!-- =================================================
                                 CARD HEADER
                                 ================================================= -->

                            <div class="audio-card-header">


                                <!-- Cover -->

                                <div class="audio-card-cover">

                                    @if (!string.IsNullOrWhiteSpace(audio.CoverImageUrl))
                                    {
                                        <img src="@audio.CoverImageUrl"
                                             alt="@audio.Title"
                                             loading="lazy" />
                                    }
                                    else
                                    {
                                        <div class="audio-card-cover-placeholder">

                                            <span aria-hidden="true">
                                                ♪
                                            </span>

                                        </div>
                                    }

                                </div>


                                <!-- Info -->

                                <div class="audio-card-info">


                                    <!-- Category -->

                                    @if (audio.Categories.Any())
                                    {
                                        <div class="audio-card-category">

                                            @string.Join(" • ", audio.Categories)

                                        </div>
                                    }


                                    <!-- Title -->

                                    <h3 class="audio-card-title">

                                        <a asp-controller="Archive"
                                           asp-action="Details"
                                           asp-route-id="@audio.Id">

                                            @audio.Title

                                        </a>

                                    </h3>


                                    <!-- Speaker -->

                                    @if (!string.IsNullOrWhiteSpace(audio.SpeakerName))
                                    {
                                        <div class="audio-card-speaker">

                                            @audio.SpeakerName

                                        </div>
                                    }

                                </div>

                            </div>


                            <!-- =================================================
                                 META
                                 ================================================= -->

                            <div class="audio-card-meta">


                                @if (audio.PublishedAt.HasValue)
                                {
                                    <span class="audio-card-date">

                                        @audio.PublishedAt.Value.ToLocalTime().ToString("yyyy/MM/dd")

                                    </span>
                                }


                                @if (audio.Duration.HasValue)
                                {
                                    <span class="audio-card-duration">

                                        @audio.Duration.Value.ToString(@"hh\:mm\:ss")

                                    </span>
                                }

                            </div>


                            <!-- =================================================
                                 AUDIO PLAYER
                                 ================================================= -->

                            @{
                                var audioUrl = audio.FileName;

                                if (!string.IsNullOrWhiteSpace(audioUrl))
                                {
                                    if (!audioUrl.StartsWith("/"))
                                    {
                                        audioUrl = "/" + audioUrl;
                                    }

                                    if (!audioUrl.StartsWith(
                                        "/uploads/",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        audioUrl =
                                            "/uploads/audio/"
                                            + audioUrl.TrimStart('/');
                                    }
                                }
                            }


                            <div class="custom-audio-player"
                                 data-player>


                                <!-- Native Audio -->

                                @if (!string.IsNullOrWhiteSpace(audioUrl))
                                {
                                    <audio class="audio-player"
                                           preload="metadata"
                                           src="@audioUrl">
                                    </audio>
                                }
                                else
                                {
                                    <audio class="audio-player"
                                           preload="metadata">
                                    </audio>
                                }


                                <!-- =================================================
                                     PLAYER HEADER
                                     ================================================= -->

                                <div class="player-top">


                                    <!-- Player Cover -->

                                    <div class="player-cover">

                                        @if (!string.IsNullOrWhiteSpace(audio.CoverImageUrl))
                                        {
                                            <img src="@audio.CoverImageUrl"
                                                 alt="@audio.Title"
                                                 loading="lazy" />
                                        }
                                        else
                                        {
                                            <div class="player-cover-placeholder">

                                                <span aria-hidden="true">
                                                    ♪
                                                </span>

                                            </div>
                                        }

                                    </div>


                                    <!-- Player Info -->

                                    <div class="player-info">

                                        <span class="player-label">
                                            پخش صوت
                                        </span>

                                        <span class="player-title">
                                            @audio.Title
                                        </span>

                                    </div>


                                    <!-- Play Button -->

                                    <button type="button"
                                            class="player-play-button"
                                            aria-label="پخش @audio.Title"
                                            title="پخش">

                                        <span class="play-icon"
                                              aria-hidden="true">
                                            ▶
                                        </span>

                                        <span class="pause-icon"
                                              aria-hidden="true">
                                            ❚❚
                                        </span>

                                    </button>

                                </div>


                                <!-- =================================================
                                     PROGRESS
                                     ================================================= -->

                                <div class="player-progress-area">


                                    <span class="player-time current-time">
                                        00:00
                                    </span>


                                    <div class="player-progress">

                                        <input type="range"
                                               class="progress-range"
                                               min="0"
                                               max="100"
                                               value="0"
                                               step="0.1"
                                               aria-label="موقعیت پخش" />

                                    </div>


                                    <span class="player-time total-time">

                                        @if (audio.Duration.HasValue)
                                        {
                                            @audio.Duration.Value.ToString(@"mm\:ss")
                                        }
                                        else
                                        {
                                            <text>00:00</text>
                                        }

                                    </span>

                                </div>


                                <!-- =================================================
                                     PLAYER FOOTER
                                     ================================================= -->

                                <div class="player-bottom">


                                    <!-- Volume -->

                                    <div class="player-volume">

                                        <button type="button"
                                                class="player-control volume-button"
                                                aria-label="قطع صدا"
                                                title="صدا">

                                            <span aria-hidden="true">
                                                🔊
                                            </span>

                                        </button>

                                        <input type="range"
                                               class="volume-range"
                                               min="0"
                                               max="1"
                                               step="0.01"
                                               value="1"
                                               aria-label="میزان صدا" />

                                    </div>


                                    <!-- Download -->

                                    @if (!string.IsNullOrWhiteSpace(audioUrl))
                                    {
                                        <a class="player-download"
                                           href="@audioUrl"
                                           download>

                                            <span aria-hidden="true">
                                                ↓
                                            </span>

                                            <span>
                                                دانلود
                                            </span>

                                        </a>
                                    }

                                </div>

                            </div>

                        </article>

                    </div>
                }
            }
            else
            {
                <!-- =================================================
                     EMPTY STATE
                     ================================================= -->

                <div class="col-12">

                    <div class="archive-empty">

                        <div class="archive-empty-icon"
                             aria-hidden="true">
                            ♪
                        </div>

                        <h3>
                            هنوز فایل صوتی‌ای پیدا نشد
                        </h3>

                        <p>
                            در حال حاضر محتوایی مطابق درخواست شما وجود ندارد.
                        </p>

                    </div>

                </div>
            }

        </div>


        <!-- =====================================================
             PAGINATION
             ===================================================== -->

        @if (Model.TotalPages > 1)
        {
            <nav class="archive-pagination"
                 aria-label="صفحه‌بندی آرشیو">


                <!-- Previous -->

                @if (Model.CurrentPage > 1)
                {
                    <a asp-controller="Archive"
                       asp-action="Index"
                       asp-route-search="@Model.Search"
                       asp-route-categoryId="@Model.CategoryId"
                       asp-route-speakerId="@Model.SpeakerId"
                       asp-route-sort="@Model.Sort"
                       asp-route-page="@(Model.CurrentPage - 1)"
                       class="pagination-arrow"
                       aria-label="صفحه قبل">

                        →

                    </a>
                }


                <!-- Pages -->

                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <a asp-controller="Archive"
                       asp-action="Index"
                       asp-route-search="@Model.Search"
                       asp-route-categoryId="@Model.CategoryId"
                       asp-route-speakerId="@Model.SpeakerId"
                       asp-route-sort="@Model.Sort"
                       asp-route-page="@i"
                       class="@(i == Model.CurrentPage ? "active" : "")"
                       aria-label="صفحه @i">

                        @i

                    </a>
                }


                <!-- Next -->

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <a asp-controller="Archive"
                       asp-action="Index"
                       asp-route-search="@Model.Search"
                       asp-route-categoryId="@Model.CategoryId"
                       asp-route-speakerId="@Model.SpeakerId"
                       asp-route-sort="@Model.Sort"
                       asp-route-page="@(Model.CurrentPage + 1)"
                       class="pagination-arrow"
                       aria-label="صفحه بعد">

                        ←

                    </a>
                }

            </nav>
        }

    </div>

</section>


@section Scripts {

    <script src="~/js/archive-player.js"
            asp-append-version="true"></script>

}