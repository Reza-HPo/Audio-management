@model Web.Models.ViewModels.Archive.ArchiveViewModel

@{
    ViewData["Title"] = "آرشیو صوتی";
}

@section Styles {

    <link rel="stylesheet"
          href="~/css/archive.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/player.css"
          asp-append-version="true" />

}


<section class="archive-page">

    <!-- =====================================================
         HERO
    ====================================================== -->

    <header class="archive-hero">

        <div class="container">

            <div class="archive-hero-content">

                <div class="archive-eyebrow">

                    <span class="archive-eyebrow-dot"></span>

                    <span>
                        آرشیو صوتی مجالس اهواز
                    </span>

                </div>


                <h1>

                    صدای مجالس،
                    <span>همیشه در دسترس شما</span>

                </h1>


                <p>

                    مجموعه‌ای از سخنرانی‌ها و فایل‌های صوتی
                    مجالس اهواز را جستجو، گوش کنید و
                    محتوای مورد نظر خود را پیدا کنید.

                </p>

            </div>

        </div>

    </header>



    <!-- =====================================================
         MAIN
    ====================================================== -->

    <main class="container archive-container">


        <!-- =================================================
             SEARCH
        ================================================== -->

        <section class="archive-search-wrapper">

            <form asp-controller="Archive"
                  asp-action="Index"
                  method="get"
                  class="archive-search-form">

                <div class="archive-search-box">


                    <span class="archive-search-icon"
                          aria-hidden="true">

                        <span></span>

                    </span>


                    <input type="search"
                           name="search"
                           value="@Model.Search"
                           placeholder="جستجو در عنوان، سخنران یا محتوای سخنرانی..."
                           autocomplete="off"
                           aria-label="جستجو در آرشیو صوتی" />


                    <button type="submit">

                        <span>
                            جستجو
                        </span>

                        <span class="search-arrow"
                              aria-hidden="true">

                            ←

                        </span>

                    </button>

                </div>

            </form>

        </section>



        <!-- =================================================
             FILTER PANEL
        ================================================== -->

        <section class="archive-filter-panel">


            <div class="filter-panel-header">


                <div class="filter-panel-heading">

                    <span class="filter-panel-label">

                        فیلتر و مرتب‌سازی

                    </span>


                    <span class="filter-panel-description">

                        محتوای مورد نظر خود را سریع‌تر پیدا کنید.

                    </span>

                </div>


                @if (
                    Model.CategoryId.HasValue ||
                    Model.SpeakerId.HasValue ||
                    !string.IsNullOrWhiteSpace(Model.Search) ||
                    Model.Sort != "newest"
                )
                {

                    <a asp-controller="Archive"
                       asp-action="Index"
                       class="clear-filters">

                        <span>
                            پاک کردن فیلترها
                        </span>

                        <span aria-hidden="true">
                            ×
                        </span>

                    </a>

                }

            </div>



            <form asp-controller="Archive"
                  asp-action="Index"
                  method="get"
                  class="archive-filter-form">


                <input type="hidden"
                       name="search"
                       value="@Model.Search" />


                <div class="archive-filters">


                    <!-- =====================================
                         CATEGORY
                    ====================================== -->

                    <div class="filter-group">

                        <label for="categoryId">

                            دسته‌بندی

                        </label>


                        <div class="filter-select-wrapper">

                            <select id="categoryId"
                                    name="categoryId"
                                    onchange="this.form.submit()">

                                <option value="">

                                    همه دسته‌بندی‌ها

                                </option>


                                @foreach (var category in Model.Categories)
                                {

                                    if (Model.CategoryId == category.Id)
                                    {

                                        <option value="@category.Id"
                                                selected>

                                            @category.Name

                                        </option>

                                    }
                                    else
                                    {

                                        <option value="@category.Id">

                                            @category.Name

                                        </option>

                                    }

                                }

                            </select>

                        </div>

                    </div>



                    <!-- =====================================
                         SPEAKER
                    ====================================== -->

                    <div class="filter-group">

                        <label for="speakerId">

                            سخنران

                        </label>


                        <div class="filter-select-wrapper">

                            <select id="speakerId"
                                    name="speakerId"
                                    onchange="this.form.submit()">

                                <option value="">

                                    همه سخنران‌ها

                                </option>


                                @foreach (var speaker in Model.Speakers)
                                {

                                    if (Model.SpeakerId == speaker.Id)
                                    {

                                        <option value="@speaker.Id"
                                                selected>

                                            @speaker.Name

                                        </option>

                                    }
                                    else
                                    {

                                        <option value="@speaker.Id">

                                            @speaker.Name

                                        </option>

                                    }

                                }

                            </select>

                        </div>

                    </div>



                    <!-- =====================================
                         SORT
                    ====================================== -->

                    <div class="filter-group">

                        <label for="sort">

                            مرتب‌سازی

                        </label>


                        <div class="filter-select-wrapper">

                            <select id="sort"
                                    name="sort"
                                    onchange="this.form.submit()">

                                @if (Model.Sort == "newest")
                                {

                                    <option value="newest"
                                            selected>

                                        جدیدترین

                                    </option>

                                }
                                else
                                {

                                    <option value="newest">

                                        جدیدترین

                                    </option>

                                }


                                @if (Model.Sort == "oldest")
                                {

                                    <option value="oldest"
                                            selected>

                                        قدیمی‌ترین

                                    </option>

                                }
                                else
                                {

                                    <option value="oldest">

                                        قدیمی‌ترین

                                    </option>

                                }


                                @if (Model.Sort == "alphabetical")
                                {

                                    <option value="alphabetical"
                                            selected>

                                        الفبایی

                                    </option>

                                }
                                else
                                {

                                    <option value="alphabetical">

                                        الفبایی

                                    </option>

                                }

                            </select>

                        </div>

                    </div>

                </div>

            </form>

        </section>



        <!-- =================================================
             RESULTS HEADER
        ================================================== -->

        <section class="archive-results-header">


            <div class="results-title">


                <div class="results-icon"
                     aria-hidden="true">

                    ♪

                </div>


                <div class="results-title-content">

                    <strong>

                        فایل‌های صوتی

                    </strong>


                    <span>

                        @Model.TotalCount فایل
                        در آرشیو مجالس اهواز

                    </span>

                </div>

            </div>


            @if (!string.IsNullOrWhiteSpace(Model.Search))
            {

                <div class="results-search-label">

                    <span>
                        نتیجه جستجو برای:
                    </span>

                    <strong>
                        «@Model.Search»
                    </strong>

                </div>

            }

        </section>



        <!-- =================================================
             AUDIO GRID
        ================================================== -->

        <section class="archive-audio-section">


            @if (Model.Audios.Any())
            {

                <div class="row g-4 archive-audio-grid">


                    @foreach (var audio in Model.Audios)
                    {

                        /*
                         * Audio URL
                         *
                         * IMPORTANT:
                         * FileName already contains the public
                         * URL from the download server.
                         *
                         * Example:
                         * https://dl.maktabahwaz.ir/audio/file.mp3
                         */

                        var audioUrl = audio.FileName;


                        <div class="col-md-6 col-xl-4">


                            <article class="audio-card"
                                     data-audio-id="@audio.Id">


                                <!-- =================================
                                     COVER
                                ================================== -->

                                <div class="audio-card-cover">


                                    @if (!string.IsNullOrWhiteSpace(audio.CoverImageUrl))
                                    {

                                        <img src="@audio.CoverImageUrl"
                                             alt="@audio.Title"
                                             loading="lazy" />

                                    }
                                    else
                                    {

                                        <div class="audio-card-cover-placeholder">

                                            <div class="cover-placeholder-icon">
                                                ♪
                                            </div>

                                            <span>
                                                مجالس اهواز
                                            </span>

                                        </div>

                                    }


                                    <div class="audio-cover-overlay">

                                        <span>

                                            پخش صوت

                                        </span>

                                    </div>


                                    <!-- Cover Details -->

                                    <div class="audio-cover-badge">

                                        <span aria-hidden="true">
                                            ♪
                                        </span>

                                        <span>
                                            صوتی
                                        </span>

                                    </div>

                                </div>



                                <!-- =================================
                                     CONTENT
                                ================================== -->

                                <div class="audio-card-content">


                                    <!-- Categories -->

                                    @if (audio.Categories.Any())
                                    {

                                        <div class="audio-card-category">

                                            @foreach (var category in audio.Categories)
                                            {

                                                <span>
                                                    @category
                                                </span>

                                            }

                                        </div>

                                    }



                                    <!-- Title -->

                                    <h2 class="audio-card-title">

                                        <a asp-controller="Archive"
                                           asp-action="Details"
                                           asp-route-id="@audio.Id">

                                            @audio.Title

                                        </a>

                                    </h2>



                                    <!-- Speaker -->

                                    @if (!string.IsNullOrWhiteSpace(audio.SpeakerName))
                                    {

                                        <div class="audio-card-speaker">


                                            <span class="speaker-icon"
                                                  aria-hidden="true">

                                                ◉

                                            </span>


                                            <span>

                                                @audio.SpeakerName

                                            </span>

                                        </div>

                                    }



                                    <!-- Metadata -->

                                    <div class="audio-card-meta">


                                        @if (audio.PublishedAt.HasValue)
                                        {

                                            <span>

                                                <span aria-hidden="true">
                                                    ◷
                                                </span>

                                                @audio.PublishedAt.Value.ToLocalTime().ToString("yyyy/MM/dd")

                                            </span>

                                        }


                                        @if (audio.Duration.HasValue)
                                        {

                                            <span>

                                                <span aria-hidden="true">
                                                    ⏱
                                                </span>

                                                @audio.Duration.Value.ToString(@"hh\:mm\:ss")

                                            </span>

                                        }

                                    </div>



                                    <!-- =================================
                                         PLAYER
                                    ================================== -->

                                    <div class="custom-audio-player"
                                         data-player>


                                        <!-- Native Audio -->

                                        @if (!string.IsNullOrWhiteSpace(audioUrl))
                                        {

                                            <audio class="audio-player"
                                                   preload="metadata"
                                                   src="@audioUrl">

                                            </audio>

                                        }
                                        else
                                        {

                                            <audio class="audio-player"
                                                   preload="metadata">

                                            </audio>

                                        }



                                        <!-- Player Top -->

                                        <div class="player-top">


                                            <!-- Mini Cover -->

                                            <div class="player-cover">


                                                @if (!string.IsNullOrWhiteSpace(audio.CoverImageUrl))
                                                {

                                                    <img src="@audio.CoverImageUrl"
                                                         alt="@audio.Title"
                                                         loading="lazy" />

                                                }
                                                else
                                                {

                                                    <div class="player-cover-placeholder">

                                                        ♪

                                                    </div>

                                                }

                                            </div>



                                            <!-- Info -->

                                            <div class="player-info">


                                                <span class="player-label">

                                                    پخش صوت

                                                </span>


                                                <span class="player-title">

                                                    @audio.Title

                                                </span>

                                            </div>



                                            <!-- Play -->

                                            <button type="button"
                                                    class="player-play-button"
                                                    aria-label="پخش @audio.Title"
                                                    title="پخش">


                                                <span class="play-icon"
                                                      aria-hidden="true">

                                                    ▶

                                                </span>


                                                <span class="pause-icon"
                                                      aria-hidden="true">

                                                    ❚❚

                                                </span>


                                            </button>

                                        </div>



                                        <!-- Progress -->

                                        <div class="player-progress-area">


                                            <span class="player-time current-time">

                                                00:00

                                            </span>


                                            <div class="player-progress">


                                                <input type="range"
                                                       class="progress-range"
                                                       min="0"
                                                       max="100"
                                                       value="0"
                                                       step="0.1"
                                                       aria-label="موقعیت پخش" />

                                            </div>


                                            <span class="player-time total-time">


                                                @if (audio.Duration.HasValue)
                                                {

                                                    @audio.Duration.Value.ToString(@"mm\:ss")

                                                }
                                                else
                                                {

                                                    <text>
                                                        00:00
                                                    </text>

                                                }

                                            </span>

                                        </div>



                                        <!-- Bottom Controls -->

                                        <div class="player-bottom">


                                            <!-- Volume -->

                                            <div class="player-volume">


                                                <button type="button"
                                                        class="player-control volume-button"
                                                        aria-label="قطع صدا"
                                                        title="صدا">

                                                    <span aria-hidden="true">
                                                        🔊
                                                    </span>

                                                </button>


                                                <input type="range"
                                                       class="volume-range"
                                                       min="0"
                                                       max="1"
                                                       step="0.01"
                                                       value="1"
                                                       aria-label="میزان صدا" />

                                            </div>



                                            <!-- Details -->

                                            <a asp-controller="Archive"
                                               asp-action="Details"
                                               asp-route-id="@audio.Id"
                                               class="player-details">

                                                <span>
                                                    جزئیات
                                                </span>

                                                <span class="player-details-arrow"
                                                      aria-hidden="true">

                                                    ←

                                                </span>

                                            </a>



                                            <!-- Download -->

                                            @if (
                                                audio.IsDownloadable &&
                                                !string.IsNullOrWhiteSpace(audioUrl)
                                            )
                                            {

                                                <a class="player-download"
                                                   href="@audioUrl"
                                                   download
                                                   aria-label="دانلود @audio.Title"
                                                   title="دانلود">


                                                    <span aria-hidden="true">

                                                        ↓

                                                    </span>


                                                    <span>

                                                        دانلود

                                                    </span>


                                                </a>

                                            }

                                        </div>

                                    </div>

                                </div>

                            </article>

                        </div>

                    }

                </div>

            }
            else
            {

                <!-- =============================================
                     EMPTY STATE
                ============================================== -->

                <div class="archive-empty">


                    <div class="archive-empty-icon"
                         aria-hidden="true">

                        ♪

                    </div>


                    <h2>

                        فایل صوتی پیدا نشد

                    </h2>


                    <p>

                        موردی مطابق جستجو یا فیلترهای انتخاب‌شده
                        پیدا نکردیم.

                    </p>


                    <a asp-controller="Archive"
                       asp-action="Index">

                        <span>
                            مشاهده همه فایل‌ها
                        </span>

                        <span aria-hidden="true">
                            ←
                        </span>

                    </a>

                </div>

            }

        </section>



        <!-- =================================================
             PAGINATION
        ================================================== -->

        @if (Model.TotalPages > 1)
        {

            <nav class="archive-pagination"
                 aria-label="صفحه‌بندی آرشیو">


                <!-- Previous -->

                @if (Model.CurrentPage > 1)
                {

                    <a asp-controller="Archive"
                       asp-action="Index"
                       asp-route-search="@Model.Search"
                       asp-route-categoryId="@Model.CategoryId"
                       asp-route-speakerId="@Model.SpeakerId"
                       asp-route-sort="@Model.Sort"
                       asp-route-page="@(Model.CurrentPage - 1)"
                       class="pagination-arrow"
                       aria-label="صفحه قبل">

                        →

                    </a>

                }



                <!-- Pages -->

                @for (var i = 1; i <= Model.TotalPages; i++)
                {

                    <a asp-controller="Archive"
                       asp-action="Index"
                       asp-route-search="@Model.Search"
                       asp-route-categoryId="@Model.CategoryId"
                       asp-route-speakerId="@Model.SpeakerId"
                       asp-route-sort="@Model.Sort"
                       asp-route-page="@i"
                       class="@(i == Model.CurrentPage ? "active" : "")"
                       aria-label="صفحه @i"
                       aria-current="@(i == Model.CurrentPage ? "page" : null)">

                        @i

                    </a>

                }



                <!-- Next -->

                @if (Model.CurrentPage < Model.TotalPages)
                {

                    <a asp-controller="Archive"
                       asp-action="Index"
                       asp-route-search="@Model.Search"
                       asp-route-categoryId="@Model.CategoryId"
                       asp-route-speakerId="@Model.SpeakerId"
                       asp-route-sort="@Model.Sort"
                       asp-route-page="@(Model.CurrentPage + 1)"
                       class="pagination-arrow"
                       aria-label="صفحه بعد">

                        ←

                    </a>

                }

            </nav>

        }

    </main>

</section>



@section Scripts {

    <script src="~/js/archive-player.js"
            asp-append-version="true"></script>

}