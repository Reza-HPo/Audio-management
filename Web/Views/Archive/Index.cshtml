@model Web.Models.ViewModels.Archive.ArchiveViewModel

@{
    ViewData["Title"] = "آرشیو صوتی";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/archive.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/player.css"
          asp-append-version="true" />
}

<section class="archive-page">

    <!-- ============================================
         ARCHIVE HERO
    ============================================= -->

    <div class="archive-hero">

        <div class="container">

            <div class="archive-hero-content">

                <div class="archive-eyebrow">
                    <span class="archive-eyebrow-dot"></span>

                    آرشیو صوتی مجالس اهواز
                </div>

                <h1>
                    محتوای مورد نظرتان
                    <span>اینجاست</span>
                </h1>

                <p>
                    میان مجموعه‌ای از سخنرانی‌ها و فایل‌های صوتی
                    جستجو کنید و محتوای مورد نظر خود را به‌سادگی پیدا کنید.
                </p>

            </div>

        </div>

    </div>


    <div class="container archive-container">

        <!-- ============================================
             SEARCH
        ============================================= -->

        <div class="archive-search-wrapper">

            <form asp-controller="Archive"
                  asp-action="Index"
                  method="get"
                  class="archive-search-form">

                <div class="archive-search-box">

                    <span class="archive-search-icon"
                          aria-hidden="true">
                        <span></span>
                    </span>

                    <input type="search"
                           name="search"
                           value="@Model.Search"
                           placeholder="نام سخنرانی، موضوع یا محتوا را جستجو کنید..."
                           autocomplete="off"
                           aria-label="جستجو در آرشیو صوتی" />

                    <button type="submit">
                        <span>جستجو</span>
                        <span class="search-arrow">←</span>
                    </button>

                </div>

            </form>

        </div>


        <!-- ============================================
             FILTERS
        ============================================= -->

        <div class="archive-filter-panel">

            <div class="filter-panel-header">

                <div>
                    <span class="filter-panel-label">
                        فیلتر و مرتب‌سازی
                    </span>

                    <span class="filter-panel-description">
                        نتایج را بر اساس نیاز خود محدود کنید.
                    </span>
                </div>

                @if (
                    Model.CategoryId.HasValue ||
                    Model.SpeakerId.HasValue ||
                    !string.IsNullOrWhiteSpace(Model.Search) ||
                    Model.Sort != "newest"
                )
                {
                    <a asp-controller="Archive"
                       asp-action="Index"
                       class="clear-filters">
                        پاک کردن فیلترها
                    </a>
                }

            </div>


            <form asp-controller="Archive"
                  asp-action="Index"
                  method="get"
                  class="archive-filter-form">

                <input type="hidden"
                       name="search"
                       value="@Model.Search" />

                <div class="archive-filters">

                    <!-- Category -->

                    <div class="filter-group">

                        <label for="categoryId">
                            دسته‌بندی
                        </label>

                        <div class="filter-select-wrapper">

                            <select id="categoryId"
                                    name="categoryId"
                                    onchange="this.form.submit()">

                                <option value="">
                                    همه دسته‌بندی‌ها
                                </option>

                                @foreach (var category in Model.Categories)
                                {
                                    if (Model.CategoryId == category.Id)
                                    {
                                        <option value="@category.Id"
                                                selected>
                                            @category.Name
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@category.Id">
                                            @category.Name
                                        </option>
                                    }
                                }

                            </select>

                        </div>

                    </div>


                    <!-- Speaker -->

                    <div class="filter-group">

                        <label for="speakerId">
                            سخنران
                        </label>

                        <div class="filter-select-wrapper">

                            <select id="speakerId"
                                    name="speakerId"
                                    onchange="this.form.submit()">

                                <option value="">
                                    همه سخنران‌ها
                                </option>

                                @foreach (var speaker in Model.Speakers)
                                {
                                    if (Model.SpeakerId == speaker.Id)
                                    {
                                        <option value="@speaker.Id"
                                                selected>
                                            @speaker.Name
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@speaker.Id">
                                            @speaker.Name
                                        </option>
                                    }
                                }

                            </select>

                        </div>

                    </div>


                    <!-- Sort -->

                    <div class="filter-group">

                        <label for="sort">
                            مرتب‌سازی
                        </label>

                        <div class="filter-select-wrapper">

                            <select id="sort"
                                    name="sort"
                                    onchange="this.form.submit()">

                                <option value="newest"
                                        selected="@(Model.Sort == "newest")">
                                    جدیدترین
                                </option>

                                <option value="oldest"
                                        selected="@(Model.Sort == "oldest")">
                                    قدیمی‌ترین
                                </option>

                                <option value="alphabetical"
                                        selected="@(Model.Sort == "alphabetical")">
                                    الفبایی
                                </option>

                            </select>

                        </div>

                    </div>

                </div>

            </form>

        </div>


        <!-- ============================================
             RESULTS HEADER
        ============================================= -->

        <div class="archive-results-header">

            <div class="results-title">

                <span class="results-icon">
                    ♪
                </span>

                <div>

                    <strong>
                        فایل‌های صوتی
                    </strong>

                    <span>
                        @Model.TotalCount فایل در آرشیو
                    </span>

                </div>

            </div>

        </div>


        <!-- ============================================
             AUDIO GRID
        ============================================= -->

        <div class="row g-4 archive-audio-grid">

            @if (Model.Audios.Any())
            {
                foreach (var audio in Model.Audios)
                {
                    <div class="col-md-6 col-xl-4">

                        <article class="audio-card"
                                 data-audio-id="@audio.Id">


                            <!-- ====================================
                                 COVER
                            ==================================== -->

                            <div class="audio-card-cover">

                                @if (!string.IsNullOrWhiteSpace(audio.CoverImageUrl))
                                {
                                    <img src="@audio.CoverImageUrl"
                                         alt="@audio.Title"
                                         loading="lazy" />
                                }
                                else
                                {
                                    <div class="audio-card-cover-placeholder">

                                        <span>
                                            ♪
                                        </span>

                                        <small>
                                            مجالس اهواز
                                        </small>

                                    </div>
                                }


                                <div class="audio-cover-overlay">

                                    <span>
                                        پخش صوت
                                    </span>

                                </div>

                            </div>


                            <!-- ====================================
                                 CONTENT
                            ==================================== -->

                            <div class="audio-card-content">

                                @if (audio.Categories.Any())
                                {
                                    <div class="audio-card-category">

                                        @string.Join(" • ", audio.Categories)

                                    </div>
                                }


                                <h3 class="audio-card-title">

                                    <a asp-controller="Archive"
                                       asp-action="Details"
                                       asp-route-id="@audio.Id">

                                        @audio.Title

                                    </a>

                                </h3>


                                @if (!string.IsNullOrWhiteSpace(audio.SpeakerName))
                                {
                                    <div class="audio-card-speaker">

                                        <span class="speaker-icon">
                                            ◉
                                        </span>

                                        <span>
                                            @audio.SpeakerName
                                        </span>

                                    </div>
                                }


                                <div class="audio-card-meta">

                                    @if (audio.PublishedAt.HasValue)
                                    {
                                        <span>
                                            @audio.PublishedAt.Value.ToLocalTime().ToString("yyyy/MM/dd")
                                        </span>
                                    }

                                    @if (audio.Duration.HasValue)
                                    {
                                        <span>
                                            @audio.Duration.Value.ToString(@"hh\:mm\:ss")
                                        </span>
                                    }

                                </div>


                                <!-- ====================================
                                     AUDIO URL
                                ==================================== -->

                                @{
                                    var audioUrl = audio.FileName;

                                    if (!string.IsNullOrWhiteSpace(audioUrl))
                                    {
                                        if (!audioUrl.StartsWith("/"))
                                        {
                                            audioUrl = "/" + audioUrl;
                                        }

                                        if (!audioUrl.StartsWith(
                                            "/uploads/",
                                            StringComparison.OrdinalIgnoreCase))
                                        {
                                            audioUrl =
                                                "/uploads/audio/"
                                                + audioUrl.TrimStart('/');
                                        }
                                    }
                                }


                                <!-- ====================================
                                     PLAYER
                                ==================================== -->

                                <div class="custom-audio-player"
                                     data-player>

                                    @if (!string.IsNullOrWhiteSpace(audioUrl))
                                    {
                                        <audio class="audio-player"
                                               preload="metadata"
                                               src="@audioUrl">
                                        </audio>
                                    }
                                    else
                                    {
                                        <audio class="audio-player"
                                               preload="metadata">
                                        </audio>
                                    }


                                    <div class="player-top">

                                        <div class="player-cover">

                                            @if (!string.IsNullOrWhiteSpace(audio.CoverImageUrl))
                                            {
                                                <img src="@audio.CoverImageUrl"
                                                     alt="@audio.Title"
                                                     loading="lazy" />
                                            }
                                            else
                                            {
                                                <div class="player-cover-placeholder">
                                                    ♪
                                                </div>
                                            }

                                        </div>


                                        <div class="player-info">

                                            <span class="player-label">
                                                پخش صوت
                                            </span>

                                            <span class="player-title">
                                                @audio.Title
                                            </span>

                                        </div>


                                        <button type="button"
                                                class="player-play-button"
                                                aria-label="پخش @audio.Title"
                                                title="پخش">

                                            <span class="play-icon"
                                                  aria-hidden="true">
                                                ▶
                                            </span>

                                            <span class="pause-icon"
                                                  aria-hidden="true">
                                                ❚❚
                                            </span>

                                        </button>

                                    </div>


                                    <div class="player-progress-area">

                                        <span class="player-time current-time">
                                            00:00
                                        </span>

                                        <div class="player-progress">

                                            <input type="range"
                                                   class="progress-range"
                                                   min="0"
                                                   max="100"
                                                   value="0"
                                                   step="0.1"
                                                   aria-label="موقعیت پخش" />

                                        </div>

                                        <span class="player-time total-time">

                                            @if (audio.Duration.HasValue)
                                            {
                                                @audio.Duration.Value.ToString(@"mm\:ss")
                                            }
                                            else
                                            {
                                                <text>00:00</text>
                                            }

                                        </span>

                                    </div>


                                    <div class="player-bottom">

                                        <div class="player-volume">

                                            <button type="button"
                                                    class="player-control volume-button"
                                                    aria-label="قطع صدا"
                                                    title="صدا">

                                                <span aria-hidden="true">
                                                    🔊
                                                </span>

                                            </button>

                                            <input type="range"
                                                   class="volume-range"
                                                   min="0"
                                                   max="1"
                                                   step="0.01"
                                                   value="1"
                                                   aria-label="میزان صدا" />

                                        </div>


                                        @if (!string.IsNullOrWhiteSpace(audioUrl))
                                        {
                                            <a class="player-download"
                                               href="@audioUrl"
                                               download>

                                                <span aria-hidden="true">
                                                    ↓
                                                </span>

                                                <span>
                                                    دانلود
                                                </span>

                                            </a>
                                        }

                                    </div>

                                </div>

                            </div>

                        </article>

                    </div>
                }
            }
            else
            {
                <div class="col-12">

                    <div class="archive-empty">

                        <div class="archive-empty-icon">
                            ♪
                        </div>

                        <h3>
                            فایل صوتی پیدا نشد
                        </h3>

                        <p>
                            موردی مطابق جستجو یا فیلترهای انتخاب‌شده پیدا نکردیم.
                        </p>

                        <a asp-controller="Archive"
                           asp-action="Index">
                            مشاهده همه فایل‌ها
                        </a>

                    </div>

                </div>
            }

        </div>


        <!-- ============================================
             PAGINATION
        ============================================= -->

        @if (Model.TotalPages > 1)
        {
            <nav class="archive-pagination"
                 aria-label="صفحه‌بندی آرشیو">

                @if (Model.CurrentPage > 1)
                {
                    <a asp-controller="Archive"
                       asp-action="Index"
                       asp-route-search="@Model.Search"
                       asp-route-categoryId="@Model.CategoryId"
                       asp-route-speakerId="@Model.SpeakerId"
                       asp-route-sort="@Model.Sort"
                       asp-route-page="@(Model.CurrentPage - 1)"
                       class="pagination-arrow"
                       aria-label="صفحه قبل">

                        →
                    </a>
                }


                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <a asp-controller="Archive"
                       asp-action="Index"
                       asp-route-search="@Model.Search"
                       asp-route-categoryId="@Model.CategoryId"
                       asp-route-speakerId="@Model.SpeakerId"
                       asp-route-sort="@Model.Sort"
                       asp-route-page="@i"
                       class="@(i == Model.CurrentPage ? "active" : "")"
                       aria-label="صفحه @i">

                        @i

                    </a>
                }


                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <a asp-controller="Archive"
                       asp-action="Index"
                       asp-route-search="@Model.Search"
                       asp-route-categoryId="@Model.CategoryId"
                       asp-route-speakerId="@Model.SpeakerId"
                       asp-route-sort="@Model.Sort"
                       asp-route-page="@(Model.CurrentPage + 1)"
                       class="pagination-arrow"
                       aria-label="صفحه بعد">

                        ←

                    </a>
                }

            </nav>
        }

    </div>

</section>


@section Scripts {

    <script src="~/js/archive-player.js"
            asp-append-version="true"></script>

}