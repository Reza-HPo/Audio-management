@model Web.Models.ViewModels.Archive.ArchiveViewModel

@{
    ViewData["Title"] = "آرشیو صوتی";
}

<section class="archive-page">

    <div class="container">

        <!-- Header -->

        <div class="archive-header">

            <span class="section-eyebrow">
                آرشیو مکتب اهواز
            </span>

            <h1>
                آرشیو صوتی
            </h1>

            <p>
                سخنرانی‌ها و محتوای صوتی مورد نظر خود را پیدا کنید.
            </p>

        </div>


        <!-- Search -->

        <div class="archive-search">

            <form asp-controller="Archive"
                  asp-action="Index"
                  method="get">

                <div class="archive-search-box">

                    <span class="archive-search-icon">
                        ⌕
                    </span>

                    <input type="search"
                           name="Search"
                           value="@Model.Search"
                           placeholder="جستجو در سخنرانی‌ها..." />

                    <button type="submit">
                        جستجو
                    </button>

                </div>

            </form>

        </div>


        <!-- Filters -->

        <form asp-controller="Archive"
              asp-action="Index"
              method="get">

            <input type="hidden"
                   name="Search"
                   value="@Model.Search" />

            <div class="archive-filters">

                <div class="filter-group">

                    <label for="categoryId">
                        دسته‌بندی
                    </label>

                    <select id="categoryId"
                            name="CategoryId"
                            onchange="this.form.submit()">

                        <option value="">
                            همه دسته‌بندی‌ها
                        </option>

                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category.Id"
                                    selected="@(Model.CategoryId == category.Id)">
                                @category.Name
                            </option>
                        }

                    </select>

                </div>


                <div class="filter-group">

                    <label for="speakerId">
                        سخنران
                    </label>

                    <select id="speakerId"
                            name="SpeakerId"
                            onchange="this.form.submit()">

                        <option value="">
                            همه سخنران‌ها
                        </option>

                        @foreach (var speaker in Model.Speakers)
                        {
                            <option value="@speaker.Id"
                                    selected="@(Model.SpeakerId == speaker.Id)">
                                @speaker.Name
                            </option>
                        }

                    </select>

                </div>


                <div class="filter-group">

                    <label for="sort">
                        مرتب‌سازی
                    </label>

                    <select id="sort"
                            name="Sort"
                            onchange="this.form.submit()">

                        <option value="newest"
                                selected="@(Model.Sort == "newest")">
                            جدیدترین
                        </option>

                        <option value="oldest"
                                selected="@(Model.Sort == "oldest")">
                            قدیمی‌ترین
                        </option>

                        <option value="alphabetical"
                                selected="@(Model.Sort == "alphabetical")">
                            الفبایی
                        </option>

                    </select>

                </div>

            </div>

        </form>


        <!-- Results -->

        <div class="archive-results-header">

            <span>
                @Model.TotalCount فایل صوتی
            </span>

        </div>


        <!-- Audio Cards -->

        <div class="row g-4">

            @if (Model.Audios.Any())
            {
                foreach (var audio in Model.Audios)
                {
                    <div class="col-md-6 col-xl-4">

                        <article class="audio-card">

                            <div class="audio-card-top">

                                <div class="audio-cover">

                                    @if (!string.IsNullOrWhiteSpace(audio.CoverImageUrl))
                                    {
                                        <img src="@audio.CoverImageUrl"
                                             alt="@audio.Title" />
                                    }
                                    else
                                    {
                                        <span>♪</span>
                                    }

                                </div>


                                <div class="audio-card-info">

                                    @if (audio.Categories.Any())
                                    {
                                        <span class="audio-category">
                                            @string.Join(" • ", audio.Categories)
                                        </span>
                                    }

                                    <h3>
                                        @audio.Title
                                    </h3>

                                    @if (!string.IsNullOrWhiteSpace(audio.SpeakerName))
                                    {
                                        <p>
                                            @audio.SpeakerName
                                        </p>
                                    }

                                </div>

                            </div>


                            <div class="audio-card-meta">

                                @if (audio.Duration.HasValue)
                                {
                                    <span>
                                        🎧 @audio.Duration.Value.ToString(@"hh\:mm\:ss")
                                    </span>
                                }

                                @if (audio.PublishedAt.HasValue)
                                {
                                    <span>
                                        @audio.PublishedAt.Value.ToLocalTime().ToString("yyyy/MM/dd")
                                    </span>
                                }

                            </div>


                            <div class="audio-card-footer">

                                <button class="audio-play-button"
                                        type="button"
                                        onclick="toggleAudio(this)"
                                        aria-label="پخش">

                                    ▶

                                </button>

                                <div class="audio-progress">

                                    <div class="audio-progress-bar"></div>

                                </div>

                                @if (audio.Duration.HasValue)
                                {
                                    <span class="audio-duration">
                                        @audio.Duration.Value.ToString(@"mm\:ss")
                                    </span>
                                }

                                <audio preload="metadata"
                                       class="audio-player"
                                       src="@audio.FileName">
                                </audio>

                            </div>

                        </article>

                    </div>
                }
            }
            else
            {
                <div class="col-12">

                    <div class="archive-empty">

                        <div class="archive-empty-icon">
                            ♪
                        </div>

                        <h3>
                            هنوز فایل صوتی‌ای پیدا نشد
                        </h3>

                        <p>
                            در حال حاضر محتوایی مطابق درخواست شما وجود ندارد.
                        </p>

                    </div>

                </div>
            }

        </div>

    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="archive-pagination" aria-label="صفحه‌بندی">

            @if (Model.CurrentPage > 1)
            {
                <a asp-controller="Archive"
                   asp-action="Index"
                   asp-route-search="@Model.Search"
                   asp-route-categoryId="@Model.CategoryId"
                   asp-route-speakerId="@Model.SpeakerId"
                   asp-route-sort="@Model.Sort"
                   asp-route-page="@(Model.CurrentPage - 1)"
                   class="pagination-arrow">
                    →
                </a>
            }

            @for (var i = 1; i <= Model.TotalPages; i++)
            {
                <a asp-controller="Archive"
                   asp-action="Index"
                   asp-route-search="@Model.Search"
                   asp-route-categoryId="@Model.CategoryId"
                   asp-route-speakerId="@Model.SpeakerId"
                   asp-route-sort="@Model.Sort"
                   asp-route-page="@i"
                   class="@(i == Model.CurrentPage ? "active" : "")">
                    @i
                </a>
            }

            @if (Model.CurrentPage < Model.TotalPages)
            {
                <a asp-controller="Archive"
                   asp-action="Index"
                   asp-route-search="@Model.Search"
                   asp-route-categoryId="@Model.CategoryId"
                   asp-route-speakerId="@Model.SpeakerId"
                   asp-route-sort="@Model.Sort"
                   asp-route-page="@(Model.CurrentPage + 1)"
                   class="pagination-arrow">
                    ←
                </a>
            }

        </nav>
    }

    @section Scripts {

        <script>

                function toggleAudio(button) {

                    const card = button.closest(".audio-card");
                    const audio = card.querySelector(".audio-player");

                    // توقف سایر فایل‌ها
                    document.querySelectorAll(".audio-player").forEach(function(item) {

                        if (item !== audio) {
                            item.pause();

                            const otherCard = item.closest(".audio-card");

                            if (otherCard) {
                                const otherButton =
                                    otherCard.querySelector(".audio-play-button");

                                if (otherButton) {
                                    otherButton.textContent = "▶";
                                }
                            }
                        }

                    });

                    if (audio.paused) {

                        audio.play();

                        button.textContent = "❚❚";

                    }
                    else {

                        audio.pause();

                        button.textContent = "▶";

                    }
                }


                document.querySelectorAll(".audio-player").forEach(function(audio) {

                    audio.addEventListener("ended", function() {

                        const card = audio.closest(".audio-card");

                        if (card) {

                            const button =
                                card.querySelector(".audio-play-button");

                            if (button) {
                                button.textContent = "▶";
                            }

                        }

                    });

                });

        </script>

    }

</section>