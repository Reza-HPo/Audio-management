@model Web.Models.ViewModels.Archive.ArchiveViewModel

@{
    ViewData["Title"] = "آرشیو صوتی";
}

<section class="archive-page">

    <div class="container">

        <!-- =====================================================
             HEADER
             ===================================================== -->

        <div class="archive-header">

            <span class="section-eyebrow">
                آرشیو مکتب اهواز
            </span>

            <h1>
                آرشیو صوتی
            </h1>

            <p>
                سخنرانی‌ها و محتوای صوتی مورد نظر خود را پیدا کنید.
            </p>

        </div>


        <!-- =====================================================
             SEARCH
             ===================================================== -->

        <div class="archive-search">

            <form asp-controller="Archive"
                  asp-action="Index"
                  method="get">

                <div class="archive-search-box">

                    <span class="archive-search-icon">
                        ⌕
                    </span>

                    <input type="search"
                           name="search"
                           value="@Model.Search"
                           placeholder="جستجو در سخنرانی‌ها..."
                           autocomplete="off" />

                    <button type="submit">
                        جستجو
                    </button>

                </div>

            </form>

        </div>


        <!-- =====================================================
             FILTERS
             ===================================================== -->

        <form asp-controller="Archive"
              asp-action="Index"
              method="get">

            <input type="hidden"
                   name="search"
                   value="@Model.Search" />

            <div class="archive-filters">


                <!-- Category -->

                <div class="filter-group">

                    <label for="categoryId">
                        دسته‌بندی
                    </label>

                    <select id="categoryId"
                            name="categoryId"
                            onchange="this.form.submit()">

                        <option value="">
                            همه دسته‌بندی‌ها
                        </option>

                        @foreach (var category in Model.Categories)
                        {
                            if (Model.CategoryId == category.Id)
                            {
                                <option value="@category.Id" selected>
                                    @category.Name
                                </option>
                            }
                            else
                            {
                                <option value="@category.Id">
                                    @category.Name
                                </option>
                            }
                        }

                    </select>

                </div>


                <!-- Speaker -->

                <div class="filter-group">

                    <label for="speakerId">
                        سخنران
                    </label>

                    <select id="speakerId"
                            name="speakerId"
                            onchange="this.form.submit()">

                        <option value="">
                            همه سخنران‌ها
                        </option>

                        @foreach (var speaker in Model.Speakers)
                        {
                            if (Model.SpeakerId == speaker.Id)
                            {
                                <option value="@speaker.Id" selected>
                                    @speaker.Name
                                </option>
                            }
                            else
                            {
                                <option value="@speaker.Id">
                                    @speaker.Name
                                </option>
                            }
                        }

                    </select>

                </div>


                <!-- Sort -->

                <div class="filter-group">

                    <label for="sort">
                        مرتب‌سازی
                    </label>

                    <select id="sort"
                            name="sort"
                            onchange="this.form.submit()">

                        @if (Model.Sort == "newest")
                        {
                            <option value="newest" selected>
                                جدیدترین
                            </option>
                        }
                        else
                        {
                            <option value="newest">
                                جدیدترین
                            </option>
                        }

                        @if (Model.Sort == "oldest")
                        {
                            <option value="oldest" selected>
                                قدیمی‌ترین
                            </option>
                        }
                        else
                        {
                            <option value="oldest">
                                قدیمی‌ترین
                            </option>
                        }

                        @if (Model.Sort == "alphabetical")
                        {
                            <option value="alphabetical" selected>
                                الفبایی
                            </option>
                        }
                        else
                        {
                            <option value="alphabetical">
                                الفبایی
                            </option>
                        }

                    </select>

                </div>

            </div>

        </form>


        <!-- =====================================================
             RESULTS HEADER
             ===================================================== -->

        <div class="archive-results-header">

            <span>
                @Model.TotalCount فایل صوتی
            </span>

        </div>


        <!-- =====================================================
             AUDIO CARDS
             ===================================================== -->

        <div class="row g-4">

            @if (Model.Audios.Any())
            {
                foreach (var audio in Model.Audios)
                {
                    <div class="col-md-6 col-xl-4">

                        <article class="audio-card"
                                 data-audio-id="@audio.Id">


                            <!-- =================================================
                                 CARD TOP
                                 ================================================= -->

                            <div class="audio-card-top">


                                <!-- Cover -->

                                <div class="audio-cover">

                                    @if (!string.IsNullOrWhiteSpace(audio.CoverImageUrl))
                                    {
                                        <img src="@audio.CoverImageUrl"
                                             alt="@audio.Title"
                                             loading="lazy" />
                                    }
                                    else
                                    {
                                        <span>
                                            ♪
                                        </span>
                                    }

                                </div>


                                <!-- Info -->

                                <div class="audio-card-info">

                                    @if (audio.Categories.Any())
                                    {
                                        <span class="audio-category">

                                            @string.Join(" • ", audio.Categories)

                                        </span>
                                    }

                                    <h3>
                                        @audio.Title
                                    </h3>

                                    @if (!string.IsNullOrWhiteSpace(audio.SpeakerName))
                                    {
                                        <p>
                                            @audio.SpeakerName
                                        </p>
                                    }

                                </div>

                            </div>


                            <!-- =================================================
                                 META
                                 ================================================= -->

                            <div class="audio-card-meta">

                                @if (audio.Duration.HasValue)
                                {
                                    <span>
                                        🎧
                                        @audio.Duration.Value.ToString(@"hh\:mm\:ss")
                                    </span>
                                }

                                @if (audio.PublishedAt.HasValue)
                                {
                                    <span>
                                        @audio.PublishedAt.Value.ToLocalTime().ToString("yyyy/MM/dd")
                                    </span>
                                }

                            </div>


                            <!-- =================================================
                                 PLAYER
                                 ================================================= -->

                            <div class="audio-card-footer">


                                <!-- Play button -->

                                <button type="button"
                                        class="audio-play-button"
                                        aria-label="پخش @audio.Title"
                                        title="پخش">

                                    <span class="audio-play-icon">
                                        ▶
                                    </span>

                                </button>


                                <!-- Progress -->

                                <div class="audio-progress"
                                     role="slider"
                                     aria-label="موقعیت پخش">

                                    <div class="audio-progress-bar"></div>

                                </div>


                                <!-- Current / Total time -->

                                <span class="audio-duration">

                                    <span class="audio-current-time">
                                        00:00
                                    </span>

                                    <span>
                                        /
                                    </span>

                                    <span class="audio-total-time">

                                        @if (audio.Duration.HasValue)
                                        {
                                            @audio.Duration.Value.ToString(@"mm\:ss")
                                        }
                                        else
                                        {
                                            <text>00:00</text>
                                        }

                                    </span>

                                </span>


                                <!-- Actual audio element -->
                                @if (!string.IsNullOrWhiteSpace(audio.FileName))
                                {
                                    var audioUrl = audio.FileName;

                                    if (!audioUrl.StartsWith("/"))
                                    {
                                        audioUrl = "/" + audioUrl;
                                    }

                                    if (!audioUrl.StartsWith("/uploads/",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        audioUrl = "/uploads/audio/" + audioUrl.TrimStart('/');
                                    }

                                    <audio class="audio-player"
                                           preload="metadata"
                                           src="@audioUrl">
                                    </audio>
                                }
                                else
                                {
                                    <audio class="audio-player"
                                           preload="metadata">
                                    </audio>
                                }

                            </div>


                        </article>

                    </div>
                }
            }
            else
            {
                <!-- =================================================
                     EMPTY
                     ================================================= -->

                <div class="col-12">

                    <div class="archive-empty">

                        <div class="archive-empty-icon">
                            ♪
                        </div>

                        <h3>
                            هنوز فایل صوتی‌ای پیدا نشد
                        </h3>

                        <p>
                            در حال حاضر محتوایی مطابق درخواست شما وجود ندارد.
                        </p>

                    </div>

                </div>
            }

        </div>


        <!-- =====================================================
             PAGINATION
             ===================================================== -->
        @if (Model.TotalPages > 1)
        {
            <nav class="archive-pagination"
                 aria-label="صفحه‌بندی">


                @if (Model.CurrentPage > 1)
                {
                    <a asp-controller="Archive"
                       asp-action="Index"
                       asp-route-search="@Model.Search"
                       asp-route-categoryId="@Model.CategoryId"
                       asp-route-speakerId="@Model.SpeakerId"
                       asp-route-sort="@Model.Sort"
                       asp-route-page="@(Model.CurrentPage - 1)"
                       class="pagination-arrow">

                        →

                    </a>
                }


                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <a asp-controller="Archive"
                       asp-action="Index"
                       asp-route-search="@Model.Search"
                       asp-route-categoryId="@Model.CategoryId"
                       asp-route-speakerId="@Model.SpeakerId"
                       asp-route-sort="@Model.Sort"
                       asp-route-page="@i"
                       class="@(i == Model.CurrentPage ? "active" : "")">

                        @i

                    </a>
                }


                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <a asp-controller="Archive"
                       asp-action="Index"
                       asp-route-search="@Model.Search"
                       asp-route-categoryId="@Model.CategoryId"
                       asp-route-speakerId="@Model.SpeakerId"
                       asp-route-sort="@Model.Sort"
                       asp-route-page="@(Model.CurrentPage + 1)"
                       class="pagination-arrow">

                        ←

                    </a>
                }

            </nav>
        }

    </div>

</section>


@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function() {


            /*
             * ============================================================
             * AUDIO PLAYERS
             * ============================================================
             */

            const cards =
                document.querySelectorAll(".audio-card");


            cards.forEach(function(card) {


                const audio =
                    card.querySelector(".audio-player");


                const button =
                    card.querySelector(".audio-play-button");


                const playIcon =
                    card.querySelector(".audio-play-icon");


                const progress =
                    card.querySelector(".audio-progress");


                const progressBar =
                    card.querySelector(".audio-progress-bar");


                const currentTime =
                    card.querySelector(".audio-current-time");


                const totalTime =
                    card.querySelector(".audio-total-time");


                if (!audio || !button) {
                    return;
                }


                /*
                 * ========================================================
                 * PLAY / PAUSE
                 * ========================================================
                 */

                button.addEventListener("click", function() {


                    /*
                     * Stop all other players
                     */

                    document
                        .querySelectorAll(".audio-player")
                        .forEach(function(otherAudio) {

                            if (otherAudio !== audio) {

                                otherAudio.pause();

                                const otherCard =
                                    otherAudio.closest(".audio-card");

                                if (otherCard) {

                                    const otherIcon =
                                        otherCard.querySelector(".audio-play-icon");

                                    if (otherIcon) {
                                        otherIcon.textContent = "▶";
                                    }

                                    otherCard.classList.remove("is-playing");
                                }

                            }

                        });


                    /*
                     * Play current
                     */

                    if (audio.paused) {

                        const playPromise =
                            audio.play();


                        if (playPromise !== undefined) {

                            playPromise
                                .then(function() {

                                    playIcon.textContent = "❚❚";

                                    card.classList.add("is-playing");

                                })
                                .catch(function(error) {

                                    console.error(
                                        "Audio playback error:",
                                        error
                                    );

                                });

                        }

                    }
                    else {

                        audio.pause();

                    }

                });


                /*
                 * ========================================================
                 * PLAY EVENT
                 * ========================================================
                 */

                audio.addEventListener("play", function() {

                    playIcon.textContent = "❚❚";

                    card.classList.add("is-playing");

                });


                /*
                 * ========================================================
                 * PAUSE EVENT
                 * ========================================================
                 */

                audio.addEventListener("pause", function() {

                    playIcon.textContent = "▶";

                    card.classList.remove("is-playing");

                });


                /*
                 * ========================================================
                 * LOADED METADATA
                 * ========================================================
                 */

                audio.addEventListener("loadedmetadata", function() {


                    if (Number.isFinite(audio.duration)) {

                        totalTime.textContent =
                            formatTime(audio.duration);

                    }

                });


                /*
                 * ========================================================
                 * TIME UPDATE
                 * ========================================================
                 */

                audio.addEventListener("timeupdate", function() {


                    if (!Number.isFinite(audio.duration) ||
                        audio.duration <= 0) {

                        return;

                    }


                    const percent =
                        (audio.currentTime / audio.duration) * 100;


                    progressBar.style.width =
                        percent + "%";


                    currentTime.textContent =
                        formatTime(audio.currentTime);

                });


                /*
                 * ========================================================
                 * ENDED
                 * ========================================================
                 */

                audio.addEventListener("ended", function() {


                    playIcon.textContent = "▶";

                    card.classList.remove("is-playing");


                    progressBar.style.width = "0%";


                    currentTime.textContent =
                        "00:00";

                });


                /*
                 * ========================================================
                 * ERROR
                 * ========================================================
                 */

                audio.addEventListener("error", function() {

                    console.error(
                        "Unable to load audio:",
                        audio.src
                    );

                });


                /*
                 * ========================================================
                 * PROGRESS CLICK
                 * ========================================================
                 */

                if (progress) {

                    progress.addEventListener("click", function(event) {


                        if (!Number.isFinite(audio.duration) ||
                            audio.duration <= 0) {

                            return;

                        }


                        const rect =
                            progress.getBoundingClientRect();


                        const clickPosition =
                            event.clientX - rect.left;


                        const percent =
                            Math.max(
                                0,
                                Math.min(
                                    1,
                                    clickPosition / rect.width
                                )
                            );


                        audio.currentTime =
                            percent * audio.duration;

                    });

                }

            });


            /*
             * ============================================================
             * FORMAT TIME
             * ============================================================
             */

            function formatTime(seconds) {


                if (!Number.isFinite(seconds) ||
                    seconds < 0) {

                    return "00:00";

                }


                seconds =
                    Math.floor(seconds);


                const minutes =
                    Math.floor(seconds / 60);


                const remainingSeconds =
                    seconds % 60;


                return String(minutes).padStart(2, "0")
                    + ":"
                    + String(remainingSeconds).padStart(2, "0");

            }

        });

    </script>

}